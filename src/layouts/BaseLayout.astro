---
import { siteConfig } from '../data/site'
import { breadcrumbJsonLd, defaultSocialImage, localBusinessJsonLd, resolveCanonical } from '../lib/seo'
import SkipLink from '../components/navigation/SkipLink.astro'
import Header from '../components/navigation/Header.astro'
import Footer from '../components/navigation/Footer.astro'
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro'
import '../styles/global.css'
import { withBase } from '../lib/url'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  title: string
  description?: string
  canonical?: string
  image?: string
  noindex?: boolean
  currentPath?: string
  crumbs?: Crumb[]
  jsonLd?: Record<string, unknown>
}

const { title, description, canonical, image, noindex, currentPath = '/', crumbs, jsonLd } = Astro.props

const fullTitle = `${title} | ${siteConfig.name}`
const canonicalUrl = canonical ?? resolveCanonical(currentPath)
const socialImage = image ?? defaultSocialImage()
const structuredData = [localBusinessJsonLd(), crumbs ? breadcrumbJsonLd(crumbs, currentPath) : null, jsonLd].filter(Boolean)
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="icon" type="image/png" href={withBase('/assets/brand/ead-logo-on-light.png')} />
    <script is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <div
      id="scroll-pressure"
      class="fixed inset-x-0 top-0 z-50 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-gold-300 via-gold-400 to-steel-300"
      role="progressbar"
      aria-valuenow="0"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Progreso de lectura"
    ></div>
    <div
      id="scroll-pressure-bg"
      class="fixed inset-x-0 top-0 z-40 h-[3px] bg-navy-900/60"
      aria-hidden="true"
    ></div>

    <SkipLink href="#main" />

    <Header currentPath={currentPath} logoVariant="light" />

    {crumbs && <Breadcrumbs crumbs={crumbs} />}

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      const pressureBar = document.getElementById('scroll-pressure')
      const pressureBg = document.getElementById('scroll-pressure-bg')
      const header = document.getElementById('site-header')

      function onScroll() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop
        const docHeight = document.documentElement.scrollHeight - window.innerHeight
        const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0

        if (pressureBar) {
          pressureBar.style.transform = `scaleX(${progress})`
          pressureBar.setAttribute('aria-valuenow', String(Math.round(progress * 100)))
        }

        if (pressureBg && pressureBar) {
          const visible = scrollTop > 10 ? '1' : '0'
          pressureBg.style.opacity = visible
          pressureBar.style.opacity = visible
        }

        if (header) {
          if (scrollTop > 100) {
            header.classList.add('is-scrolled')
          } else {
            header.classList.remove('is-scrolled')
          }
          if (scrollTop > 10) {
            header.style.boxShadow = `0 4px 30px rgba(10, 22, 40, 0.4), 0 1px 0 rgba(240, 197, 74, ${Math.min(scrollTop / 200, 0.35)})`
          } else {
            header.style.boxShadow = ''
          }
        }
      }

      let ticking = false
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            onScroll()
            ticking = false
          })
          ticking = true
        }
      }, { passive: true })

      onScroll()

      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              revealObserver.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      )

      for (const el of document.querySelectorAll('.reveal, .reveal-left, .reveal-right')) {
        revealObserver.observe(el)
      }

      const serviceIcons = document.querySelectorAll('.service-icon-draw')
      const iconObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('icon-drawn')
              iconObserver.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.3 }
      )

      for (const el of serviceIcons) {
        iconObserver.observe(el)
      }

      const counters = document.querySelectorAll('[data-count-target]')
      const counterObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = /** @type {HTMLElement} */ (entry.target)
              const target = parseInt(el.dataset.countTarget || '0')
              const duration = 1500
              const start = performance.now()
              function tick(now) {
                const elapsed = now - start
                const progress = Math.min(elapsed / duration, 1)
                const eased = 1 - Math.pow(1 - progress, 3)
                const current = Math.round(target * eased)
                el.textContent = String(current)
                if (progress < 1) {
                  requestAnimationFrame(tick)
                }
              }
              requestAnimationFrame(tick)
              counterObserver.unobserve(el)
            }
          }
        },
        { threshold: 0.5 }
      )

      for (const el of counters) {
        counterObserver.observe(el)
      }
    </script>
  </body>
</html>
