---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/sections/PageHero.astro'
import ServiceHighlights from '../../components/sections/ServiceHighlights.astro'
import FinalCta from '../../components/sections/FinalCta.astro'
import { services } from '../../data/services'
import { routeMedia, serviceMedia } from '../../data/media'

const metaDescription =
  'Reparación integral, instalaciones, mantenimiento y repuestos oleohidráulicos en Colonia Barón, La Pampa. Conocé los servicios de EAD Oleohidráulica.'

const serviceItems = services.map(({ title, summary, slug, icon }) => ({
  title,
  summary,
  href: `/servicios/${slug}`,
  icon,
  image: serviceMedia[icon].card,
}))
---

<BaseLayout
  title="Servicios"
  description={metaDescription}
  currentPath="/servicios"
  crumbs={[
    { label: 'Servicios' },
  ]}
>
  <PageHero
    eyebrow="Servicios"
    title="Servicios oleohidráulicos"
    description="Organizamos cada consulta según el equipo y la necesidad: revisamos, presupuestamos por escrito y recién después trabajamos."
    image={routeMedia.services}
  />

  <ServiceHighlights
    heading="Áreas de trabajo"
    intro="Cuatro áreas para mantener tu equipo en marcha, con alcance definido en cada presupuesto."
    items={serviceItems}
    showAllLink={false}
    class="reveal"
  />

  <FinalCta
    heading="Contanos qué necesitás resolver"
    text="Envianos los datos del equipo para orientar la consulta y definir el próximo paso."
    cta={{ label: 'Solicitar presupuesto', href: '/contacto' }}
  />
</BaseLayout>
