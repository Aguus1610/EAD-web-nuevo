---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/sections/PageHero.astro'
import ExperienceHighlights from '../components/sections/ExperienceHighlights.astro'
import WorkProcess from '../components/sections/WorkProcess.astro'
import WorkshopGallery from '../components/sections/WorkshopGallery.astro'
import LocationContext from '../components/sections/LocationContext.astro'
import FinalCta from '../components/sections/FinalCta.astro'
import Container from '../components/ui/Container.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import PhotoFrame from '../components/ui/PhotoFrame.astro'
import { aboutContent } from '../data/about'
import { routeMedia, workshopGalleryPool, brandEquipmentGallery } from '../data/media'
import { selectGalleryImages } from '../lib/gallery'
import { siteConfig } from '../data/site'

const { intro, experience, process, gallery, location, finalCta } = aboutContent
const gallerySeed = import.meta.env.PHOTO_ROTATION_SEED || new Date().toISOString()
const landscapeImages = selectGalleryImages(
  workshopGalleryPool.filter((image) => image.orientation === 'landscape'),
  4,
  `${gallerySeed}:landscape`,
)
const portraitImages = selectGalleryImages(
  workshopGalleryPool.filter((image) => image.orientation === 'portrait'),
  2,
  `${gallerySeed}:portrait`,
)
const workshopImages = [
  ...landscapeImages.slice(0, 1),
  ...portraitImages.slice(0, 1),
  ...landscapeImages.slice(1, 3),
  ...portraitImages.slice(1, 2),
  ...landscapeImages.slice(3),
]
---

<BaseLayout
  title="Empresa"
  description="EAD Oleohidráulica, taller especializado en Colonia Barón, La Pampa. Experiencia en reparación, instalación y mantenimiento de sistemas oleohidráulicos."
  currentPath="/empresa"
  crumbs={[
    { label: 'Empresa' },
  ]}
>
  <PageHero
    eyebrow="Empresa"
    title={intro.title}
    description={intro.paragraphs[0]}
    image={routeMedia.company}
    imageLabel="Taller EAD · Colonia Barón"
  />

  <section class="bg-white py-16 sm:py-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div class="reveal">
          <p class="technical-label text-steel-600">Actividad</p>
          <SectionHeading class="mt-3">Qué hacemos</SectionHeading>
        </div>
        <div class="space-y-5 border-l border-steel-500/30 pl-6 sm:pl-8">
          {intro.paragraphs.slice(1).map((paragraph, i) => (
            <p class={`reveal reveal-delay-${i + 1} text-lg leading-relaxed text-gray-700`}>{paragraph}</p>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <ExperienceHighlights
    heading={experience.heading}
    years={experience.years}
    yearsLabel={experience.yearsLabel}
    highlights={experience.highlights}
  />

  <WorkProcess heading={process.heading} steps={process.steps} />

  <section class="bg-white py-16 sm:py-24">
    <Container>
      <div class="reveal">
        <p class="technical-label text-steel-600">Equipos representados</p>
        <SectionHeading class="mt-3">Línea de productos y equipos</SectionHeading>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600">
          {siteConfig.commercialRelationshipText} Los siguientes equipos son representativos de las líneas que trabajamos.
        </p>
      </div>
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {brandEquipmentGallery.map((image, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <PhotoFrame image={image} label={image.alt.split(',')[0] ?? image.alt.slice(0, 40)} />
          </div>
        ))}
      </div>
    </Container>
  </section>

  <WorkshopGallery
    heading={gallery.heading}
    description={gallery.description}
    emptyMessage={gallery.emptyMessage}
    images={workshopImages}
  />

  <LocationContext heading={location.heading} paragraphs={location.paragraphs} />

  <FinalCta heading={finalCta.heading} text={finalCta.text} cta={finalCta.cta} secondaryCta={finalCta.secondaryCta} />
</BaseLayout>
