---
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/ui/Container.astro'
import SectionHeading from '../components/ui/SectionHeading.astro'
import PageHero from '../components/sections/PageHero.astro'
import FinalCta from '../components/sections/FinalCta.astro'
import BrandCard from '../components/sections/BrandCard.astro'
import ProductCategoryCard from '../components/sections/ProductCategoryCard.astro'
import { brands } from '../data/brands'
import { productCategories } from '../data/productCategories'
import { productMedia, routeMedia } from '../data/media'
import { siteConfig } from '../data/site'
---

<BaseLayout
  title="Productos"
  description="Repuestos originales Hidro-Grubert y Palfinger, componentes hidráulicos e implementos. Disponibilidad bajo consulta en Colonia Barón, La Pampa."
  currentPath="/productos"
  crumbs={[
    { label: 'Productos' },
  ]}
>
  <PageHero
    eyebrow="Productos y marcas"
    title="Repuestos y componentes hidráulicos"
    description="Comercializamos repuestos originales de las marcas representadas y componentes hidráulicos. Toda disponibilidad, compatibilidad y plazo se confirman bajo consulta."
    image={routeMedia.products}
    imageLabel="Componentes del taller"
  />

  <section class="brand-surface bg-white py-16 sm:py-24">
    <Container>
      <div>
      <p class="technical-label">Marcas</p>
      <SectionHeading index="02" class="mt-4">Representaciones oficiales</SectionHeading>
      <p class="mt-5 max-w-2xl text-lg text-gray-600">{siteConfig.commercialRelationshipText}</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2" data-stagger>
        {brands.map((b) => (
          <BrandCard
            brandId={b.id}
            name={b.name}
            description={b.description}
            href={`/contacto?tipo=Repuesto%20o%20componente&marca=${encodeURIComponent(b.name)}`}
            website={b.website}
            instagram={b.instagram}
          />
        ))}
      </div>
    </Container>
  </section>

  <section class="paper-grid py-16 sm:py-24">
    <Container>
      <div>
      <p class="technical-label">Líneas de consulta</p>
      <SectionHeading index="03" class="mt-4">Categorías de productos</SectionHeading>
      <p class="mt-4 text-sm text-gray-500">
        La disponibilidad de cada producto se confirma al momento de la consulta.
        No comercializamos en línea; trabajamos con presupuesto personalizado.
      </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2" data-stagger>
        {productCategories.map((cat) => (
          <ProductCategoryCard
            title={cat.title}
            summary={cat.summary}
            examples={cat.examples}
            href={`/contacto?tipo=Repuesto%20o%20componente&equipo=${encodeURIComponent(cat.title)}`}
            icon={cat.icon}
            image={productMedia[cat.id]}
          />
        ))}
      </div>
    </Container>
  </section>

  <FinalCta
    heading="¿Necesita un repuesto o componente?"
    text="Indíquenos marca, modelo y pieza buscada para consultar compatibilidad y disponibilidad."
    cta={{ label: 'Consultar disponibilidad', href: '/contacto' }}
    secondaryCta={{ label: 'Ver servicios', href: '/servicios' }}
  />
</BaseLayout>
