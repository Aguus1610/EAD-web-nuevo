---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Container from '../../components/ui/Container.astro'
import SectionHeading from '../../components/ui/SectionHeading.astro'
import ButtonLink from '../../components/ui/ButtonLink.astro'
import PageHero from '../../components/sections/PageHero.astro'
import PhotoStrip from '../../components/sections/PhotoStrip.astro'
import ProjectCard from '../../components/sections/ProjectCard.astro'
import { getCollection } from 'astro:content'
import { routeMedia, workArchiveMedia } from '../../data/media'

const allProjects = await getCollection('projects')
const approved = allProjects
  .filter((p) => p.data.publicationApproved)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
const categories = [...new Set(approved.map((project) => project.data.category))].sort()
---

<BaseLayout
  title="Trabajos realizados"
  description="Archivo de trabajos oleohidráulicos autorizados para publicación por EAD Oleohidráulica."
  currentPath="/trabajos"
  crumbs={[
    { label: 'Trabajos' },
  ]}
>
  <PageHero
    eyebrow="Trabajos"
    title="Trabajos realizados"
    description="Este espacio reunirá intervenciones reales autorizadas para publicación. Cada registro se incorporará después de revisar su contenido e imágenes."
    image={routeMedia.work}
    imageLabel="Registro general del taller"
  />

  <section class="paper-grid py-16 sm:py-24">
    <Container>
      {approved.length > 0 ? (
        <>
        <SectionHeading index="01">Archivo publicado</SectionHeading>
        <div class="mt-8 flex flex-wrap gap-2" aria-label="Filtrar trabajos por categoría">
          <button type="button" data-project-filter="all" aria-pressed="true" class="project-filter">Todos</button>
          {categories.map((category) => (
            <button type="button" data-project-filter={category} aria-pressed="false" class="project-filter">{category}</button>
          ))}
        </div>
        <p id="project-filter-status" class="sr-only" aria-live="polite"></p>
        <div id="project-list" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {approved.map((p) => (
            <ProjectCard
              slug={p.id}
              title={p.data.title}
              summary={p.data.summary}
              category={p.data.category}
              date={p.data.date}
              image={p.data.images[0] ?? p.data.reel?.cover}
            />
          ))}
        </div>
        <p id="project-empty-filter" class="mt-8 hidden border border-gray-200 bg-white p-6 text-center text-gray-600">No hay trabajos publicados en esta categoría.</p>
        </>
      ) : (
        <div class="mx-auto max-w-3xl border-t border-navy-950/15 px-6 py-12 text-center sm:px-10 sm:py-16" data-reveal>
          <p class="technical-label">Archivo en preparación</p>
          <h2 class="mt-3 text-3xl font-bold text-navy-950">Portfolio de trabajos reales</h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-gray-600">
            Estamos preparando el portfolio con imágenes de trabajos reales. Mientras tanto, conocé nuestros servicios o consultanos directamente.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <ButtonLink href="/servicios" variant="secondary">
              Ver servicios
            </ButtonLink>
            <ButtonLink href="/contacto" variant="primary">
              Consultar
            </ButtonLink>
          </div>
        </div>
        <div class="mt-12">
          <PhotoStrip images={workArchiveMedia} label="Registro general de capacidades del taller" />
          <p class="mx-auto mt-4 max-w-3xl text-center text-xs leading-relaxed text-gray-500">
            Estas imágenes documentan capacidades y elementos del taller; no constituyen fichas de proyectos individuales.
          </p>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]')
  const empty = document.querySelector<HTMLElement>('#project-empty-filter')
  const status = document.querySelector<HTMLElement>('#project-filter-status')

  for (const button of filterButtons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter ?? 'all'
      let visible = 0
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.category === filter
        card.hidden = !show
        if (show) visible += 1
      }
      for (const current of filterButtons) current.setAttribute('aria-pressed', String(current === button))
      empty?.classList.toggle('hidden', visible > 0)
      if (status) status.textContent = `${visible} trabajo${visible === 1 ? '' : 's'} visible${visible === 1 ? '' : 's'}.`
    })
  }
</script>

<style>
  .project-filter {
    border: 1px solid var(--theme-control-border);
    border-radius: 0;
    background: var(--theme-surface);
    padding: 0.5rem 1rem;
    color: var(--theme-text-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .project-filter:hover {
    border-color: var(--theme-text-strong);
  }

  .project-filter[aria-pressed='true'] {
    border-color: var(--color-gold-400);
    background: var(--color-gold-400);
    color: var(--color-navy-950);
  }
</style>
