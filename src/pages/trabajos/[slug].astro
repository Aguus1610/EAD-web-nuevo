---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Container from '../../components/ui/Container.astro'
import ButtonLink from '../../components/ui/ButtonLink.astro'
import PageHero from '../../components/sections/PageHero.astro'
import ProjectGallery from '../../components/sections/ProjectGallery.astro'
import InstagramReel from '../../components/sections/InstagramReel.astro'
import RelatedServices from '../../components/sections/RelatedServices.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { routeMedia } from '../../data/media'
import { formatProjectDate, projectImageAsMedia } from '../../lib/projects'
import { projectJsonLd, resolveCanonical } from '../../lib/seo'

export async function getStaticPaths() {
  const allProjects = await getCollection('projects')
  const approved = allProjects.filter((p) => p.data.publicationApproved)
  return approved.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }))
}

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { data } = project
const { Content } = await render(project)
const previewImage = data.images[0] ?? data.reel?.cover
const heroImage = previewImage ? projectImageAsMedia(previewImage, `${project.id}-hero`) : routeMedia.work
const socialImage = previewImage ? resolveCanonical(previewImage.src) : undefined
const schemaImages = [...data.images.map((image) => image.src), ...(data.reel ? [data.reel.cover.src] : [])]
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={socialImage}
  ogType="article"
  currentPath={`/trabajos/${project.id}`}
  jsonLd={projectJsonLd({
    title: data.title,
    summary: data.summary,
    slug: project.id,
    date: data.date,
    images: schemaImages,
    sourceUrl: data.source?.permalink,
  })}
  crumbs={[
    { label: 'Trabajos', href: '/trabajos' },
    { label: data.title },
  ]}
>
  <PageHero
    eyebrow={data.category}
    title={data.title}
    description={data.summary}
    image={heroImage}
    imageLabel="Registro del trabajo"
    compact
  />

  <section class="paper-grid py-16 sm:py-24">
    <Container>
      <div class="grid gap-5 sm:grid-cols-2">
        <dl class="industrial-card p-6">
          <dt class="technical-label">Equipo</dt>
          <dd class="mt-2 text-lg font-bold text-navy-900">{data.equipment}</dd>
        </dl>
        <dl class="industrial-card p-6">
          <dt class="technical-label">Fecha del registro</dt>
          <dd class="mt-2 text-lg font-bold text-navy-900"><time datetime={data.date}>{formatProjectDate(data.date)}</time></dd>
        </dl>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <article class="industrial-card p-6">
          <p class="technical-label">Situación inicial</p>
          <h2 class="mt-3 text-2xl font-bold text-navy-900">Problema</h2>
          <p class="mt-3 text-base leading-relaxed text-gray-700">{data.problem}</p>
        </article>

        <article class="industrial-card p-6">
          <p class="technical-label">Trabajo realizado</p>
          <h2 class="mt-3 text-2xl font-bold text-navy-900">Intervención</h2>
          <p class="mt-3 text-base leading-relaxed text-gray-700">{data.intervention}</p>
        </article>

        <article class="industrial-card p-6">
          <p class="technical-label">Cierre</p>
          <h2 class="mt-3 text-2xl font-bold text-navy-900">Resultado</h2>
          <p class="mt-3 text-base leading-relaxed text-gray-700">{data.result}</p>
        </article>
      </div>

      {project.body?.trim() && (
        <section class="project-narrative industrial-card mt-10 p-6 sm:p-9" aria-labelledby="project-detail-title">
          <p class="technical-label">Descripción ampliada</p>
          <h2 id="project-detail-title" class="mt-3 text-3xl font-bold text-navy-900">Detalle del trabajo</h2>
          <div class="mt-5"><Content /></div>
        </section>
      )}

      <ProjectGallery images={data.images} />
      {data.reel && <InstagramReel permalink={data.reel.permalink} cover={data.reel.cover} />}

      {data.source && (
        <aside class="mt-12 border border-gray-200 bg-gray-50 p-6 sm:p-8" aria-labelledby="project-source-title">
          <p class="technical-label">Trazabilidad editorial</p>
          <h2 id="project-source-title" class="mt-3 text-2xl font-bold text-navy-950">Publicación original</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-gray-700">
            Esta ficha fue preparada a partir de una publicación de EAD Oleohidráulica y revisada antes de incorporarse al portfolio.
          </p>
          {data.source.caption && (
            <details class="mt-5 border border-gray-200 bg-white p-4">
              <summary class="cursor-pointer font-bold text-navy-950">Leer texto original de Instagram</summary>
              <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-gray-700">{data.source.caption}</p>
            </details>
          )}
          <a href={data.source.permalink} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-sm font-bold text-navy-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-steel-600">
            Abrir publicación en Instagram
          </a>
        </aside>
      )}
      <RelatedServices slugs={data.relatedServices} />

      <div class="mt-10">
        <ButtonLink href={`/contacto?tipo=Otra%20consulta&proyecto=${encodeURIComponent(data.title)}`}>Consultar sobre este trabajo</ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .project-narrative :global(p) {
    margin-top: 1rem;
    max-width: 48rem;
    color: var(--theme-text-body);
    line-height: 1.75;
  }

  .project-narrative :global(h2),
  .project-narrative :global(h3) {
    margin-top: 2rem;
    color: var(--theme-text-strong);
    font-weight: 700;
  }

  .project-narrative :global(ul) {
    margin-top: 1rem;
    list-style: disc;
    padding-left: 1.5rem;
  }

  .project-narrative :global(li + li) {
    margin-top: 0.5rem;
  }
</style>
