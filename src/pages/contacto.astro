---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/sections/PageHero.astro'
import ContactInfo from '../components/sections/ContactInfo.astro'
import QuoteForm from '../components/sections/QuoteForm.astro'
import { contactSupportMedia, routeMedia } from '../data/media'

const metaDescription =
  'Contactá a EAD Oleohidráulica por WhatsApp, teléfono o correo. Pedí presupuesto para reparación, instalación o mantenimiento hidráulico en Colonia Barón, La Pampa.'
---

<BaseLayout
  title="Contacto"
  description={metaDescription}
  currentPath="/contacto"
  crumbs={[
    { label: 'Contacto' },
  ]}
>
  <PageHero
    eyebrow="Contacto"
    title="Contacto y presupuesto"
    description="Estamos en Colonia Barón, La Pampa. Elegí el canal que prefieras: WhatsApp, teléfono o correo. Completá el formulario y te respondemos con un presupuesto sin compromiso."
    image={routeMedia.contact}
  />

  <ContactInfo showHeading={false} />

  <QuoteForm image={contactSupportMedia} />
</BaseLayout>
