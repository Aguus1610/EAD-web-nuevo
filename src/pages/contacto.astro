---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/sections/PageHero.astro'
import ContactInfo from '../components/sections/ContactInfo.astro'
import QuoteForm from '../components/sections/QuoteForm.astro'

const metaDescription =
  'Contacte a EAD Oleohidráulica por WhatsApp, teléfono o correo. Solicite presupuesto para reparación, instalación o mantenimiento hidráulico en Colonia Barón, La Pampa.'
---

<BaseLayout
  title="Contacto"
  description={metaDescription}
  currentPath="/contacto"
  crumbs={[
    { label: 'Contacto' },
  ]}
>
  <PageHero
    eyebrow="Contacto"
    title="Contacto y presupuesto"
    description="Estamos en Colonia Barón, La Pampa. Puede consultarnos por el canal que prefiera."
    visual="contact"
  />

  <ContactInfo showHeading={false} />

  <QuoteForm />
</BaseLayout>
