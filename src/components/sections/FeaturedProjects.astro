---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import PhotoFrame from '../ui/PhotoFrame.astro'
import ProjectCard from './ProjectCard.astro'
import type { MediaImage } from '../../data/media'
import type { ProjectImage } from '../../lib/projects'

interface ProjectEntry {
  slug: string
  title: string
  summary: string
  category: string
  date: string
  image?: ProjectImage
}

interface Props {
  heading: string
  emptyMessage: string
  projects?: ProjectEntry[]
  evidenceImages?: readonly MediaImage[]
  class?: string
}

const { heading, emptyMessage, projects, evidenceImages = [], class: className } = Astro.props
---

<section class={`bg-white py-16 sm:py-24 ${className ?? ''}`}>
  <Container>
    <div>
      <p class="technical-label">Archivo de trabajos</p>
      <SectionHeading index="04" class="mt-4">{heading}</SectionHeading>
    </div>

    {projects && projects.length > 0 ? (
      <>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {projects.map((p) => (
            <ProjectCard {...p} />
          ))}
        </div>
        <div class="mt-10">
          <ButtonLink href="/trabajos" variant="secondary">
            Ver todos los trabajos
          </ButtonLink>
        </div>
      </>
    ) : (
      <div class="archive-panel" data-reveal>
        <div class="archive-copy">
          <p class="technical-label">Archivo en preparación</p>
          <p class="relative z-10 mt-5 max-w-lg text-lg leading-relaxed text-gray-200">{emptyMessage}</p>
          <div class="relative z-10 mt-8 flex flex-wrap gap-4">
            <ButtonLink href="/trabajos" variant="primary">
              Ver archivo
            </ButtonLink>
            <ButtonLink href="/servicios" variant="inverse">
              Conocer servicios
            </ButtonLink>
          </div>
        </div>

        <div class="archive-evidence" data-stagger>
          {evidenceImages.map((image, index) => (
            <PhotoFrame
              image={image}
              class={index === 0 ? 'min-h-64' : 'min-h-40'}
            />
          ))}
        </div>
      </div>
    )}
  </Container>
</section>
