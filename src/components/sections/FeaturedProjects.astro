---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import PhotoFrame from '../ui/PhotoFrame.astro'
import ProjectCard from './ProjectCard.astro'
import type { MediaImage } from '../../data/media'
import type { ProjectImage } from '../../lib/projects'

interface ProjectEntry {
  slug: string
  title: string
  summary: string
  category: string
  date: string
  image?: ProjectImage
}

interface Props {
  heading: string
  emptyMessage: string
  projects?: ProjectEntry[]
  evidenceImages?: readonly MediaImage[]
  class?: string
}

const { heading, emptyMessage, projects, evidenceImages = [], class: className } = Astro.props
const evidenceClasses = ['col-span-2 min-h-44', 'min-h-40', 'min-h-40']
---

<section class={`bg-white py-16 sm:py-24 ${className ?? ''}`}>
  <Container>
    <SectionHeading>{heading}</SectionHeading>

    {projects && projects.length > 0 ? (
      <>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p, i) => (
            <ProjectCard {...p} class={`reveal reveal-delay-${i + 1}`} />
          ))}
        </div>
        <div class="reveal mt-10 text-center">
          <ButtonLink href="/trabajos" variant="secondary">
            Ver todos los trabajos
          </ButtonLink>
        </div>
      </>
    ) : (
      <div class="reveal mt-10 grid overflow-hidden rounded-xl border border-steel-500/30 bg-navy-900 shadow-2xl shadow-navy-900/15 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="flex flex-col justify-center p-7 sm:p-10">
          <p class="technical-label text-gold-300">Archivo en preparación</p>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-200">{emptyMessage}</p>
          <div class="mt-7 flex flex-wrap gap-4">
            <ButtonLink href="/trabajos" variant="primary">
              Ver archivo
            </ButtonLink>
          <ButtonLink href="/servicios" variant="secondary" class="border-steel-300 text-white hover:border-white hover:bg-white hover:text-navy-900">
            Conocer servicios
          </ButtonLink>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2 border-t border-white/10 bg-navy-950/60 p-3 lg:border-l lg:border-t-0 sm:p-5">
          {evidenceImages.map((image, index) => (
            <PhotoFrame
              image={image}
              label={index === 0 ? 'Registro general del taller' : undefined}
              class={`rounded-md ${evidenceClasses[index] ?? 'min-h-40'}`}
            />
          ))}
        </div>
      </div>
    )}
  </Container>
</section>
