---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import TechnicalVisual from '../ui/TechnicalVisual.astro'
import { withBase } from '../../lib/url'

interface ProjectEntry {
  slug: string
  title: string
  summary: string
  category: string
}

interface Props {
  heading: string
  emptyMessage: string
  projects?: ProjectEntry[]
  class?: string
}

const { heading, emptyMessage, projects, class: className } = Astro.props
---

<section class={`bg-white py-16 sm:py-24 ${className ?? ''}`}>
  <div class="section-pressure-gauge" aria-hidden="true"></div>
  <div class="sticky-content-wrapper">
  <Container>
    <SectionHeading>{heading}</SectionHeading>

    {projects && projects.length > 0 ? (
      <>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p, i) => (
            <article class={`reveal reveal-delay-${i + 1} industrial-card p-6`}>
              <span class="technical-label text-steel-600">{p.category}</span>
              <h3 class="mt-3 text-xl font-bold text-navy-900">
                <a href={withBase(`/trabajos/${p.slug}`)} class="text-inherit no-underline hover:text-steel-600">
                  {p.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{p.summary}</p>
            </article>
          ))}
        </div>
        <div class="reveal mt-10 text-center">
          <ButtonLink href="/trabajos" variant="secondary">
            Ver todos los trabajos
          </ButtonLink>
        </div>
      </>
    ) : (
      <div class="reveal mt-10 grid overflow-hidden rounded-xl border border-steel-500/30 bg-navy-900 shadow-2xl shadow-navy-900/15 lg:grid-cols-[0.85fr_1.15fr]">
        <div class="flex flex-col justify-center p-7 sm:p-10">
          <p class="technical-label text-gold-300">Archivo en preparación</p>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-200">{emptyMessage}</p>
          <div class="mt-7 flex flex-wrap gap-4">
            <ButtonLink href="/trabajos" variant="primary">
              Ver archivo
            </ButtonLink>
          <ButtonLink href="/servicios" variant="secondary" class="border-steel-300 text-white hover:border-white hover:bg-white hover:text-navy-900">
            Conocer servicios
          </ButtonLink>
          </div>
        </div>
        <div class="border-t border-white/10 bg-navy-950/40 p-5 lg:border-l lg:border-t-0 sm:p-8">
          <TechnicalVisual variant="work" />
        </div>
      </div>
    )}
  </Container>
  </div>
</section>
