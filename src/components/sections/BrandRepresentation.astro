---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import BrandLogo from '../ui/BrandLogo.astro'
import { siteConfig } from '../../data/site'
import { withBase } from '../../lib/url'

interface Props {
  heading: string
  note: string
  class?: string
}

const { heading, note, class: className } = Astro.props
---

<section class={`border-y border-light-200 bg-white py-12 sm:py-16 ${className ?? ''}`}>
  <Container>
    <div class="reveal relative text-center">
      <p class="technical-label text-blue-600">Marcas representadas</p>
      <SectionHeading class="mt-3">{heading}</SectionHeading>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-700">{siteConfig.commercialRelationshipText}</p>
      <div class="mx-auto mt-9 flex max-w-xl flex-wrap items-center justify-center gap-x-12 gap-y-8">
        <a
          href={withBase('/productos')}
          class="group flex items-center justify-center transition-opacity hover:opacity-70"
          aria-label="Ver repuestos Hidro-Grubert"
        >
          <BrandLogo brand="hidro-grubert" class="h-auto max-h-12 w-auto max-w-full" loading="lazy" />
        </a>
        <a
          href={withBase('/productos')}
          class="group flex items-center justify-center transition-opacity hover:opacity-70"
          aria-label="Ver repuestos Palfinger"
        >
          <BrandLogo brand="palfinger" class="h-auto max-h-12 w-auto max-w-full" loading="lazy" />
        </a>
      </div>
      <p class="mt-7 inline-block border-l-2 border-yellow-400 pl-4 text-left text-sm text-ink-700">{note}</p>
    </div>
  </Container>
</section>
