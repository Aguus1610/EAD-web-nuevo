---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import BrandLogo from '../ui/BrandLogo.astro'
import { siteConfig } from '../../data/site'
import { withBase } from '../../lib/url'

interface Props {
  heading: string
  note: string
  class?: string
}

const { heading, note, class: className } = Astro.props
---

<section class={`dark-technical-grid relative overflow-hidden border-y border-navy-700 py-16 sm:py-24 ${className ?? ''}`}>
  <div class="brand-diagonal brand-diagonal--soft" aria-hidden="true"></div>
  <Container>
    <div class="relative z-10 grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-16">
      <div>
        <p class="technical-label">Marcas representadas</p>
        <SectionHeading light index="03" class="mt-4">{heading}</SectionHeading>
      </div>
      <p class="max-w-2xl text-lg leading-relaxed text-gray-200">{siteConfig.commercialRelationshipText}</p>
    </div>

    <div class="brand-rail relative z-10" data-stagger>
      <a
        href={withBase('/productos')}
        class="brand-rail__link group"
        aria-label="Ver repuestos Hidro-Grubert"
        data-reveal
      >
        <BrandLogo brand="hidro-grubert" class="h-auto max-h-14 max-w-full" loading="lazy" />
      </a>
      <a
        href={withBase('/productos')}
        class="brand-rail__link group"
        aria-label="Ver repuestos Palfinger"
        data-reveal
      >
        <BrandLogo brand="palfinger" class="h-auto max-h-14 max-w-full" loading="lazy" />
      </a>
    </div>

    <p class="relative z-10 mt-7 max-w-2xl border-l border-gold-400 pl-4 text-sm leading-relaxed text-steel-100">{note}</p>
  </Container>
</section>
