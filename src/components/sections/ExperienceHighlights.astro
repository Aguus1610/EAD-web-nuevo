---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  heading: string
  years: number | null
  yearsLabel: string | null
  highlights: string[]
}

const { heading, years, yearsLabel, highlights } = Astro.props
---

<section class="paper-grid py-16 sm:py-24">
  <Container>
    <SectionHeading>{heading}</SectionHeading>

    <div class="mt-10 grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      {years !== null && yearsLabel && (
        <div class="relative flex min-h-72 flex-col justify-center overflow-hidden rounded-xl bg-navy-900 p-8 text-white shadow-2xl shadow-navy-900/20">
          <div class="absolute right-4 top-4 h-40 w-40 rounded-full border-[1.5rem] border-steel-500/20" aria-hidden="true"></div>
          <p class="technical-label relative text-gold-300">Experiencia en el rubro</p>
          <span class="relative mt-2 text-8xl font-bold leading-none text-white sm:text-9xl" style="font-family: var(--font-display)"><span data-count-target={String(years)} id="years-counter">0</span><span class="text-gold-300">+</span></span>
          <span class="relative mt-3 max-w-xs text-lg text-steel-100">{yearsLabel}</span>
        </div>
      )}

      {highlights.length > 0 && (
        <ul class="grid gap-4 sm:grid-cols-2">
          {highlights.map((item) => (
            <li class="industrial-card flex min-h-32 items-start gap-4 p-5 sm:p-6">
              <svg class="mt-0.5 h-9 w-9 shrink-0 text-steel-600" fill="none" viewBox="0 0 32 32" stroke="currentColor" aria-hidden="true">
                <circle cx="16" cy="16" r="13" stroke-width="2" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 16l4 4 8-9" />
              </svg>
              <span class="font-medium leading-relaxed text-gray-700">{item}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>
