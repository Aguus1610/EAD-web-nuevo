---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  heading: string
  years: number | null
  yearsLabel: string | null
  highlights: string[]
}

const { heading, years, yearsLabel, highlights } = Astro.props
---

<section class="paper-grid py-16 sm:py-24">
  <Container>
    <p class="technical-label">Trayectoria</p>
    <SectionHeading index="02" class="mt-4">{heading}</SectionHeading>

    <div class="experience-layout">
      {years !== null && yearsLabel && (
        <div data-reveal>
          <p class="technical-label">Experiencia en el rubro</p>
          <p class="experience-number mt-5">
            {years}<span>+</span>
          </p>
          <p class="mt-6 max-w-xs border-t border-navy-950/20 pt-4 text-lg text-navy-900">{yearsLabel}</p>
        </div>
      )}

      {highlights.length > 0 && (
        <ul class="experience-list" data-stagger>
          {highlights.map((item) => (
            <li class="experience-item" data-reveal>
              <svg class="mt-0.5 h-8 w-8 shrink-0 text-steel-600" fill="none" viewBox="0 0 32 32" stroke="currentColor" aria-hidden="true">
                <circle cx="16" cy="16" r="13" stroke-width="1.5" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 16l4 4 8-9" />
              </svg>
              <span class="font-medium leading-relaxed text-gray-700">{item}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>
