---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import CraneLineCard from './CraneLineCard.astro'
import type { CraneLine } from '../../data/craneLines'

interface Props {
  heading: string
  intro: string
  items: readonly CraneLine[]
}

const { heading, intro, items } = Astro.props
---

<section class="bg-white py-16 sm:py-24" aria-labelledby="crane-lines-heading">
  <Container>
    <div>
      <p class="technical-label">Equipos representados</p>
      <SectionHeading id="crane-lines-heading" index="04" class="mt-4">{heading}</SectionHeading>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600">{intro}</p>
    </div>
    <div class="mt-9 grid gap-6 sm:grid-cols-2" data-stagger>
      {items.map((item) => (
        <CraneLineCard {...item} />
      ))}
    </div>
  </Container>
</section>
