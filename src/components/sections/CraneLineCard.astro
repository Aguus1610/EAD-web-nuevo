---
import PhotoFrame from '../ui/PhotoFrame.astro'
import { withBase } from '../../lib/url'
import type { CraneLine } from '../../data/craneLines'

interface Props extends CraneLine {
  class?: string
}

const {
  title,
  badge,
  description,
  image,
  websiteUrl,
  ctaLabel,
  ctaHref,
  class: className,
} = Astro.props
---

<article class={`service-tile group ${className ?? ''}`} data-reveal data-spotlight>
  <a
    href={websiteUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="service-tile__media block"
    aria-label={`${title} · sitio oficial de la marca`}
    data-pointer-media
  >
    <PhotoFrame image={image} class="w-full" />
    <span
      class="pointer-events-none absolute right-4 top-4 z-10 inline-flex items-center gap-1.5 text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-white"
      aria-hidden="true"
    >
      Sitio oficial
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10" />
      </svg>
    </span>
  </a>

  <div class="service-tile__body">
    <p class="technical-label">{badge}</p>
    <h3 class="mt-3 text-xl font-bold text-navy-950">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-gray-600">{description}</p>
    <a
      href={withBase(ctaHref)}
      class="service-tile__cta mt-auto pt-6"
    >
      {ctaLabel}
    </a>
  </div>
</article>
