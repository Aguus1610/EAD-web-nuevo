---
import { withBase } from '../../lib/url'
import type { ProjectImage } from '../../lib/projects'

interface Props {
  images: ProjectImage[]
}

const { images } = Astro.props
---

{images.length > 0 && (
  <section aria-labelledby="project-gallery-title" class="mt-12">
    <h2 id="project-gallery-title" class="text-2xl font-semibold text-navy-900">Galería</h2>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {images.map((image) => (
        <figure class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-lg shadow-navy-900/5">
          <a href={withBase(image.src)} target="_blank" rel="noopener noreferrer" class="block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel-500">
            <img
              src={withBase(image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
              style={`object-position: ${image.position ?? '50% 50%'};`}
              class="aspect-4/3 h-auto w-full object-cover transition-transform duration-500 hover:scale-[1.025]"
            />
          </a>
          {image.caption && <figcaption class="border-t border-gray-200 px-4 py-3 text-sm leading-relaxed text-gray-600">{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
    <p class="mt-3 text-xs text-gray-500">Seleccione una imagen para abrirla en tamaño completo.</p>
  </section>
)}
