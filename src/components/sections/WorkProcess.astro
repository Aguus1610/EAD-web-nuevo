---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  heading: string
  steps: { title: string; description: string }[]
}

const { heading, steps } = Astro.props
---

<section class="process-section dark-technical-grid" aria-labelledby="process-heading">
  <Container>
    <div class="process-layout">
      <div class="process-aside" data-reveal>
        <p class="technical-label">Proceso de trabajo</p>
        <SectionHeading id="process-heading" light index="03" class="mt-4">{heading}</SectionHeading>
        <div class="process-meter" data-process-track aria-hidden="true">
          <span class="process-meter__fill"></span>
        </div>
      </div>

      <ol class="process-steps">
        {steps.map((step, i) => (
          <li class={`process-step ${i === 0 ? 'is-active' : ''}`} data-process-step>
            <span class="process-step__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <h3 class="text-xl font-bold text-white sm:text-2xl">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-gray-300 sm:text-base">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
