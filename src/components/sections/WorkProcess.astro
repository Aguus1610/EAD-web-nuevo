---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  heading: string
  steps: { title: string; description: string }[]
}

const { heading, steps } = Astro.props
---

<section class="dark-technical-grid border-y border-deep-700 py-16 sm:py-24">
  <Container>
    <p class="technical-label text-yellow-400">Proceso de trabajo</p>
    <SectionHeading light class="mt-3">{heading}</SectionHeading>

    <ol class="relative mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class={`reveal reveal-delay-${i + 1} relative border border-white/15 border-t-2 border-t-yellow-400 bg-deep-800 p-6 transition-colors hover:border-white/40`}>
          <span class="technical-label text-yellow-400">
            Etapa {String(i + 1).padStart(2, '0')}
          </span>
          <div class="my-5 h-px bg-white/20" aria-hidden="true"></div>
          <h3 class="text-xl font-bold text-white">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-light-100">{step.description}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
