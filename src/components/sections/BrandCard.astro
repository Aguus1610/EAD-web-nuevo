---
import BrandLogo from '../ui/BrandLogo.astro'
import { withBase } from '../../lib/url'

interface Props {
  brandId: 'hidro-grubert' | 'palfinger'
  name: string
  description: string
  href: string
}

const { brandId, name, description, href } = Astro.props
---

<article class="industrial-card p-6 sm:p-8">
  <p class="technical-label text-steel-600">Consulta de repuestos</p>
  <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
    <div class="flex min-h-20 w-full items-center rounded-lg border border-gray-200 bg-white p-4 sm:w-56">
      <BrandLogo brand={brandId} alt="" class="h-auto max-h-12 max-w-full" loading="lazy" />
    </div>
    <h3 class="break-words text-xl font-semibold text-navy-900">{name}</h3>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-gray-600">{description}</p>
  <a href={withBase(href)} class="mt-5 inline-flex text-sm font-bold text-navy-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-steel-600">
    Consultar por {name}
  </a>
</article>
