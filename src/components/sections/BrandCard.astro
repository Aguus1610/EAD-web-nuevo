---
import BrandLogo from '../ui/BrandLogo.astro'
import { withBase } from '../../lib/url'

interface Props {
  brandId: 'hidro-grubert' | 'palfinger'
  name: string
  description: string
  href: string
  website: string
  instagram: string
}

const { brandId, name, description, href, website, instagram } = Astro.props
---

<article class="industrial-card p-6 pt-6 sm:p-8 sm:pt-8" data-reveal>
  <p class="technical-label">Consulta de repuestos</p>
  <div class="mt-5 flex flex-col items-start gap-4 lg:flex-row lg:items-center">
    <div class="flex min-h-16 w-full items-center lg:w-64">
      <BrandLogo brand={brandId} alt="" class="h-auto max-h-10 max-w-full" loading="lazy" />
    </div>
    <h3 class="break-words text-xl font-semibold text-navy-950">{name}</h3>
  </div>
  <p class="mt-4 text-sm leading-relaxed text-gray-600">{description}</p>

  <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href={withBase(href)} class="inline-flex text-sm font-bold text-navy-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-steel-600">
      Consultar repuesto
    </a>
    <a href={website} target="_blank" rel="noopener noreferrer" class="inline-flex text-sm font-bold text-navy-800 underline decoration-steel-300 underline-offset-4 hover:text-steel-600">
      Sitio oficial
    </a>
    <a href={instagram} target="_blank" rel="noopener noreferrer" class="inline-flex text-sm font-bold text-navy-800 underline decoration-steel-300 underline-offset-4 hover:text-steel-600">
      Instagram
    </a>
  </div>
</article>
