---
import Container from '../ui/Container.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import BrandLogo from '../ui/BrandLogo.astro'
import HeroBackdrop from '../ui/HeroBackdrop.astro'
import type { MediaImage } from '../../data/media'

interface Props {
  title: string
  owner: string
  subtitle: string
  ctaPrimary: { label: string; href: string }
  ctaSecondary: { label: string; href: string }
  image: MediaImage
  class?: string
}

const { title, owner, subtitle, ctaPrimary, ctaSecondary, image, class: className } = Astro.props
---

<section class={`dark-technical-grid relative isolate overflow-hidden border-b border-deep-700 py-12 sm:py-16 ${className ?? ''}`}>
  <HeroBackdrop image={image} />
  <span class="corner-yellow pointer-events-none absolute right-0 top-0 z-10 h-24 w-24 bg-yellow-400/15" aria-hidden="true"></span>
  <Container>
    <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="reveal min-w-0">
        <BrandLogo brand="ead" variant="light" class="mb-4 h-24 w-auto sm:h-28" />
        <h1 class="text-balance mt-2 text-4xl font-bold leading-tight text-white sm:text-5xl xl:text-6xl">
          {title}
        </h1>
        <p class="mt-2 text-xl font-medium tracking-wide text-light-100 sm:text-2xl">{owner}</p>
        <p class="mt-5 max-w-2xl border-l-2 border-yellow-400 pl-5 text-base leading-relaxed text-light-100 sm:text-lg">
          {subtitle}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <ButtonLink href={ctaPrimary.href} variant="primary">
            {ctaPrimary.label}
          </ButtonLink>
          <ButtonLink href={ctaSecondary.href} variant="secondary-light">
            {ctaSecondary.label}
          </ButtonLink>
        </div>
      </div>

      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>
  </Container>
</section>
