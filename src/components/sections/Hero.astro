---
import Container from '../ui/Container.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import BrandLogo from '../ui/BrandLogo.astro'
import HeroBackdrop from '../ui/HeroBackdrop.astro'
import type { MediaImage } from '../../data/media'

interface Props {
  title: string
  subtitle: string
  ctaPrimary: { label: string; href: string }
  ctaSecondary: { label: string; href: string }
  image: MediaImage
  class?: string
}

const { title, subtitle, ctaPrimary, ctaSecondary, image, class: className } = Astro.props
---

<section class={`dark-technical-grid relative isolate overflow-hidden border-b border-deep-700 py-16 sm:py-24 ${className ?? ''}`}>
  <HeroBackdrop image={image} />
  <span class="corner-yellow pointer-events-none absolute right-0 top-0 z-10 h-28 w-28 bg-yellow-400/15" aria-hidden="true"></span>
  <Container>
    <div class="relative z-10 grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal min-w-0">
        <BrandLogo brand="ead" variant="light" class="mb-5 h-20 sm:h-24" />
        <p class="technical-label text-yellow-400">Oleohidráulica · Colonia Barón</p>
        <h1 class="text-balance mt-4 text-4xl font-bold leading-tight text-white sm:text-6xl lg:text-7xl">
          {title}
        </h1>
        <p class="mt-6 max-w-2xl border-l-2 border-yellow-400 pl-5 text-lg leading-relaxed text-light-100 sm:text-xl">
          {subtitle}
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <ButtonLink href={ctaPrimary.href} variant="primary">
            {ctaPrimary.label}
          </ButtonLink>
          <ButtonLink href={ctaSecondary.href} variant="secondary-light">
            {ctaSecondary.label}
          </ButtonLink>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/20 pt-5 text-sm text-light-100" aria-label="Áreas principales">
          <li>Reparación</li>
          <li>Instalación</li>
          <li>Mantenimiento</li>
          <li>Repuestos</li>
        </ul>
      </div>

      <div class="hidden lg:block" aria-hidden="true"></div>
    </div>
  </Container>
</section>
