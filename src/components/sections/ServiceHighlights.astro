---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import ServiceIcon from '../ui/ServiceIcon.astro'
import PhotoFrame from '../ui/PhotoFrame.astro'
import type { MediaImage } from '../../data/media'
import type { ServiceIconVariant } from '../../data/services'
import { withBase } from '../../lib/url'

interface ServiceItem {
  title: string
  summary: string
  href: string
  icon: ServiceIconVariant
  image: MediaImage
}

interface Props {
  heading: string
  items: ServiceItem[]
  intro?: string
  showAllLink?: boolean
  class?: string
  index?: string
}

const { heading, items, intro, showAllLink = true, class: className, index = '02' } = Astro.props
---

<section class={`service-section paper-grid ${className ?? ''}`}>
  <Container>
    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-16">
      <div>
        <p class="technical-label">Áreas de servicio</p>
        <SectionHeading index={index} class="mt-4">{heading}</SectionHeading>
      </div>
      {intro && <p class="max-w-2xl text-lg leading-relaxed text-gray-600">{intro}</p>}
    </div>

    <div class="service-grid" data-stagger>
      {items.map((item, index) => (
        <a href={withBase(item.href)} class="service-tile group" data-reveal data-spotlight>
          <div class="service-tile__media" data-pointer-media>
            <span class="service-tile__index" aria-hidden="true">{String(index + 1).padStart(2, '0')} / 04</span>
            <PhotoFrame image={item.image} class="w-full" />
          </div>
          <article class="service-tile__body">
            <div class="flex items-start justify-between gap-5">
              <div class="min-w-0">
                <p class="technical-label">Servicio</p>
                <h3 class="mt-3 text-2xl font-bold text-navy-950">{item.title}</h3>
              </div>
              <ServiceIcon variant={item.icon} class="service-tile__icon" />
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">{item.summary}</p>
            <span class="service-tile__cta mt-auto pt-6">Conocer servicio</span>
          </article>
        </a>
      ))}
    </div>

    {showAllLink && (
      <div class="mt-12">
        <ButtonLink href="/servicios" variant="secondary">
          Ver todos los servicios
        </ButtonLink>
      </div>
    )}
  </Container>
</section>
