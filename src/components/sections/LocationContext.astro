---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { siteConfig } from '../../data/site'
import { telUrl, whatsappUrl } from '../../lib/contact'

interface Props {
  heading: string
  paragraphs: string[]
}

const { heading, paragraphs } = Astro.props
---

<section class="paper-grid py-16 sm:py-24">
  <Container>
    <SectionHeading>{heading}</SectionHeading>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1fr]">
      <div class="reveal-left rounded-xl bg-navy-900 p-7 text-white shadow-2xl shadow-navy-900/15 sm:p-9">
        <p class="technical-label text-gold-300">Base operativa</p>
        {paragraphs.map((p) => (
          <p class="mt-4 text-lg leading-relaxed text-gray-200">{p}</p>
        ))}
      </div>

      <div class="reveal-right industrial-card p-6 sm:p-8">
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="technical-label text-steel-600">Dirección</dt>
            <dd class="mt-1 text-gray-600">{siteConfig.address}, {siteConfig.locality}</dd>
          </div>
          <div>
            <dt class="technical-label text-steel-600">Provincia</dt>
            <dd class="mt-1 text-gray-600">{siteConfig.province}, {siteConfig.country}</dd>
          </div>
          <div>
            <dt class="technical-label text-steel-600">Horario</dt>
            <dd class="mt-1 text-gray-600">{siteConfig.hours}</dd>
          </div>
          <div>
            <dt class="technical-label text-steel-600">Teléfonos</dt>
            <dd class="mt-2 space-y-3">
              {siteConfig.contacts.map((contact) => (
                <div>
                  <p class="font-semibold text-navy-900">{contact.name}</p>
                  <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
                    <a href={telUrl(contact.phone)} aria-label={`Llamar a ${contact.name} al ${contact.phone}`} class="text-gray-700 underline decoration-steel-400 underline-offset-4 hover:text-steel-600">{contact.phone}</a>
                    <a
                      href={whatsappUrl('Hola, vi la web de EAD Oleohidráulica y quería hacer una consulta.', contact.whatsapp)}
                      aria-label={`Abrir WhatsApp de ${contact.name} al ${contact.phone}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-semibold text-steel-600 underline decoration-steel-400 underline-offset-4 hover:text-steel-700"
                    >
                      WhatsApp
                    </a>
                  </div>
                </div>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Container>
</section>
