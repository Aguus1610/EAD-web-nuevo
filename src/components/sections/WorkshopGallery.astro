---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import type { MediaImage } from '../../data/media'
import { withBase } from '../../lib/url'

interface Props {
  heading: string
  description: string
  emptyMessage: string
  images?: readonly MediaImage[]
}

const { heading, description, emptyMessage, images = [] } = Astro.props
const tileClasses = [
  'sm:col-span-2 lg:col-span-7 lg:row-span-2',
  'lg:col-span-5 lg:row-span-2',
  'lg:col-span-6',
  'lg:col-span-6',
  'lg:col-span-4 lg:row-span-2',
  'lg:col-span-8 lg:row-span-2',
]
---

<section class="bg-white py-16 sm:py-24">
  <Container>
    <div class="grid gap-4 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-12">
      <div>
        <p class="technical-label text-steel-600">Registro visual</p>
        <SectionHeading class="mt-3">{heading}</SectionHeading>
      </div>
      <p class="max-w-2xl text-base leading-relaxed text-gray-600">{description}</p>
    </div>

    {images.length > 0 ? (
      <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:auto-rows-[16rem] lg:grid-cols-12">
        {images.map((image, index) => (
          <li class={`reveal group relative min-h-64 overflow-hidden rounded-lg border border-steel-500/30 bg-navy-950 shadow-lg shadow-navy-900/10 lg:min-h-0 ${tileClasses[index] ?? 'lg:col-span-4'}`}>
            <a
              href={withBase(image.src)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Abrir imagen: ${image.alt}`}
              class="block h-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel-500"
            >
              <img
                src={withBase(image.src)}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/30 via-transparent to-transparent" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="reveal mt-10 grid overflow-hidden rounded-xl border border-steel-500/30 bg-navy-900 lg:grid-cols-2">
        <div class="flex min-h-64 items-center justify-center p-8 sm:p-12">
          <svg class="h-24 w-24 text-steel-300" viewBox="0 0 96 96" fill="none" aria-hidden="true">
            <rect x="13" y="20" width="70" height="56" rx="6" stroke="currentColor" stroke-width="4" />
            <circle cx="34" cy="39" r="8" stroke="#f0c54a" stroke-width="4" />
            <path d="M18 67L37 49L50 60L62 47L78 63" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="flex flex-col justify-center border-t border-white/10 p-7 sm:p-10 lg:border-l lg:border-t-0">
          <p class="technical-label text-gold-300">Registro visual</p>
          <h3 class="mt-3 text-3xl font-bold text-white">Imágenes reales, publicación responsable</h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-gray-300">{emptyMessage}</p>
        </div>
      </div>
    )}
  </Container>
</section>
