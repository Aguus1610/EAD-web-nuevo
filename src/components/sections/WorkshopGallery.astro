---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import TechnicalVisual from '../ui/TechnicalVisual.astro'

interface Props {
  heading: string
  emptyMessage: string
}

const { heading, emptyMessage } = Astro.props
---

<section class="bg-white py-16 sm:py-24">
  <Container>
    <SectionHeading>{heading}</SectionHeading>

    <div class="reveal mt-10 grid overflow-hidden rounded-xl border border-steel-500/30 bg-navy-900 lg:grid-cols-2">
      <div class="p-5 sm:p-8">
        <TechnicalVisual variant="work" />
      </div>
      <div class="flex flex-col justify-center border-t border-white/10 p-7 sm:p-10 lg:border-l lg:border-t-0">
        <p class="technical-label text-gold-300">Registro visual</p>
        <h3 class="mt-3 text-3xl font-bold text-white">Imágenes reales, publicación responsable</h3>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-gray-300">{emptyMessage}</p>
      </div>
    </div>
  </Container>
</section>
