---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import type { MediaImage } from '../../data/media'
import { withBase } from '../../lib/url'

interface Props {
  heading: string
  description: string
  emptyMessage: string
  images?: readonly MediaImage[]
  index?: string
}

const { heading, description, emptyMessage, images = [], index = '04' } = Astro.props
const tileClasses = [
  'sm:col-span-2 lg:col-span-7 lg:row-span-2',
  'lg:col-span-5 lg:row-span-2',
  'lg:col-span-6',
  'lg:col-span-6',
  'lg:col-span-4 lg:row-span-2',
  'lg:col-span-8 lg:row-span-2',
]
---

<section class="bg-white py-16 sm:py-24">
  <Container>
    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-16">
      <div>
        <p class="technical-label">Registro visual</p>
        <SectionHeading index={index} class="mt-4">{heading}</SectionHeading>
      </div>
      <p class="max-w-2xl text-base leading-relaxed text-gray-600">{description}</p>
    </div>

    {images.length > 0 ? (
      <ul class="gallery-grid" data-stagger>
        {images.map((image, index) => (
          <li class={`gallery-tile group ${tileClasses[index] ?? 'lg:col-span-4'}`} data-reveal data-scrub data-pointer-media>
            <span class="gallery-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <a
              href={withBase(image.src)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Abrir imagen: ${image.alt}`}
              class="block h-full"
            >
              <img
                src={withBase(image.src)}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="archive-panel" data-reveal>
        <div class="flex min-h-64 items-center justify-center p-8 sm:p-12">
          <svg class="h-24 w-24 text-steel-300" viewBox="0 0 96 96" fill="none" aria-hidden="true">
            <rect x="13" y="20" width="70" height="56" stroke="currentColor" stroke-width="2" />
            <circle cx="34" cy="39" r="8" stroke="#ffda24" stroke-width="2" />
            <path d="M18 67L37 49L50 60L62 47L78 63" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="flex flex-col justify-center p-7 sm:p-10">
          <p class="technical-label">Registro visual</p>
          <h3 class="mt-4 text-3xl font-bold text-white">Imágenes reales, publicación responsable</h3>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-gray-300">{emptyMessage}</p>
        </div>
      </div>
    )}
  </Container>
</section>
