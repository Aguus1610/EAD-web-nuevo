---
import PhotoFrame from '../ui/PhotoFrame.astro'
import type { MediaImage } from '../../data/media'

interface Props {
  eyebrow: string
  title: string
  description: string
  image?: MediaImage
  imageLabel?: string
  compact?: boolean
}

const { eyebrow, title, description, image, compact = false } = Astro.props
---

<section class={`dark-technical-grid relative overflow-hidden border-b border-navy-700 ${compact ? 'page-hero--compact' : ''}`} data-scroll-hero>
  <div class="brand-diagonal brand-diagonal--soft" aria-hidden="true"></div>

  <div class={`page-hero__layout relative z-10 ${compact ? 'page-hero__layout--compact' : ''}`}>
    <div class="page-hero__copy" data-reveal>
      <p class="technical-label">{eyebrow}</p>
      <h1 class={`mt-5 font-bold uppercase leading-[0.92] text-white ${compact ? 'text-4xl sm:text-5xl' : 'text-4xl sm:text-5xl lg:text-6xl'}`}>
        {title}
      </h1>
      <p class="hero-lead mt-6 max-w-2xl text-lg leading-relaxed text-gray-200 sm:text-xl">
        {description}
      </p>
    </div>

    {image ? (
      <div class="page-hero__media" data-parallax="0.045" data-parallax-range="42">
        <PhotoFrame image={image} class="h-full min-h-full w-full" priority />
      </div>
    ) : (
      <div class="page-hero__fallback">
        <div class="relative z-10 flex max-w-xs flex-col items-center px-6 text-center">
          <svg class="h-20 w-20 text-steel-300" viewBox="0 0 96 96" fill="none" aria-hidden="true">
            <circle cx="20" cy="48" r="7" stroke="currentColor" stroke-width="4" />
            <circle cx="76" cy="48" r="7" stroke="currentColor" stroke-width="4" />
            <path d="M27 48H40M56 48H69" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
            <path d="M42 37L54 59M54 37L42 59" stroke="#ffda24" stroke-width="5" stroke-linecap="round" />
          </svg>
          <p class="technical-label mt-4">Ruta interrumpida</p>
        </div>
      </div>
    )}
  </div>
</section>
