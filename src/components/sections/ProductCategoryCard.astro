---
import { withBase } from '../../lib/url'

interface Props {
  title: string
  summary: string
  examples: string[]
  href: string
}

const { title, summary, examples, href } = Astro.props
---

<article class="industrial-card p-6 sm:p-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="technical-label text-steel-600">Consulta por categoría</p>
      <h3 class="mt-2 text-2xl font-bold text-navy-900">{title}</h3>
    </div>
    <svg class="h-12 w-12 shrink-0 text-gold-500" viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <rect x="8" y="14" width="32" height="22" rx="3" stroke="currentColor" stroke-width="2" />
      <path d="M24 14V36M8 25H40M13 19L19 23M29 28L35 32" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-gray-600">{summary}</p>

  {examples.length > 0 && (
    <>
      <h4 class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">Ejemplos</h4>
      <ul class="mt-2 space-y-1">
        {examples.map((item) => (
          <li class="flex items-start gap-2 text-sm text-gray-600">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-steel-500" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <a href={withBase(href)} class="mt-5 inline-flex text-sm font-bold text-navy-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-steel-600">
    Consultar categoría
  </a>
</article>
