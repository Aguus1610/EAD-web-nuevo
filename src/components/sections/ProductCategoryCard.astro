---
import { withBase } from '../../lib/url'
import type { MediaImage } from '../../data/media'
import type { ProductIconVariant } from '../../data/productCategories'
import PhotoFrame from '../ui/PhotoFrame.astro'
import ProductIcon from '../ui/ProductIcon.astro'

interface Props {
  title: string
  summary: string
  examples: string[]
  href: string
  icon: ProductIconVariant
  image: MediaImage
}

const { title, summary, examples, href, icon, image } = Astro.props
---

<article class="industrial-card flex h-full flex-col">
  <div class="relative">
    <PhotoFrame image={image} label="Registro general del taller" class="aspect-[16/7] w-full" />
    <ProductIcon variant={icon} class="absolute -bottom-7 right-6 z-10 h-14 w-14" />
  </div>
  <div class="flex flex-1 flex-col p-6 pt-10 sm:p-8 sm:pt-11">
    <div>
      <p class="technical-label text-blue-600">Consulta por categoría</p>
      <h3 class="mt-2 text-2xl font-bold text-deep-900">{title}</h3>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-ink-700">{summary}</p>

    {examples.length > 0 && (
      <>
        <h4 class="mt-4 text-xs font-semibold uppercase tracking-wider text-ink-500">Ejemplos</h4>
        <ul class="mt-2 space-y-1">
          {examples.map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink-700">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <a href={withBase(href)} class="mt-auto inline-flex pt-5 text-sm font-bold text-deep-900 underline decoration-yellow-400 decoration-2 underline-offset-4 hover:text-blue-600">
      Consultar categoría
    </a>
  </div>
</article>
