---
import { withBase } from '../../lib/url'
import type { MediaImage } from '../../data/media'
import type { ProductIconVariant } from '../../data/productCategories'
import PhotoFrame from '../ui/PhotoFrame.astro'
import ProductIcon from '../ui/ProductIcon.astro'

interface Props {
  title: string
  summary: string
  examples: string[]
  href: string
  icon: ProductIconVariant
  image: MediaImage
}

const { title, summary, examples, href, icon, image } = Astro.props
---

<article class="service-tile group" data-reveal data-spotlight>
  <div class="service-tile__media" data-pointer-media>
    <PhotoFrame image={image} class="w-full" />
  </div>
  <div class="service-tile__body">
    <div class="flex items-start justify-between gap-5">
      <div class="min-w-0">
        <p class="technical-label">Consulta por categoría</p>
        <h3 class="mt-3 text-2xl font-bold text-navy-950">{title}</h3>
      </div>
      <ProductIcon variant={icon} class="h-12 w-12 shrink-0 text-navy-950" />
    </div>
    <p class="mt-3 text-sm leading-relaxed text-gray-600">{summary}</p>

    {examples.length > 0 && (
      <>
        <h4 class="mt-5 text-xs font-bold uppercase tracking-[0.1em] text-gray-500">Ejemplos</h4>
        <ul class="mt-2 space-y-1">
          {examples.map((item) => (
            <li class="flex items-start gap-2 text-sm text-gray-600">
              <span class="mt-1.5 h-px w-4 shrink-0 bg-gold-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <a href={withBase(href)} class="service-tile__cta mt-auto pt-6">
      Consultar categoría
    </a>
  </div>
</article>
