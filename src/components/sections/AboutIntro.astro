---
import Container from '../ui/Container.astro'

interface Props {
  title: string
  paragraphs: string[]
}

const { title, paragraphs } = Astro.props
---

<section class="bg-white py-16 sm:py-24">
  <Container narrow>
    <h1 class="text-4xl font-bold leading-tight text-navy-900 sm:text-5xl">{title}</h1>
    {paragraphs.map((p) => (
      <p class="mt-4 text-lg leading-relaxed text-gray-700 first:mt-6">{p}</p>
    ))}
  </Container>
</section>
