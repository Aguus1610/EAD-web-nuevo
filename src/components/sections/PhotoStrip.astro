---
import type { MediaImage } from '../../data/media'
import PhotoFrame from '../ui/PhotoFrame.astro'

interface Props {
  images: readonly MediaImage[]
  label: string
  class?: string
}

const { images, label, class: className } = Astro.props
---

<ul class={`grid gap-3 sm:grid-cols-2 lg:grid-cols-3 ${className ?? ''}`} aria-label={label}>
  {images.map((image) => (
    <li>
      <PhotoFrame
        image={image}
        class="aspect-[4/3]"
      />
    </li>
  ))}
</ul>
