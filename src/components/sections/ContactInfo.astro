---
import { siteConfig } from '../../data/site'
import { telUrl } from '../../lib/contact'
import Container from '../ui/Container.astro'

interface Props {
  showHeading?: boolean
}

const { showHeading = true } = Astro.props
---

<section class={`paper-grid ${showHeading ? 'py-16 sm:py-24' : 'py-16 sm:py-24'}`} aria-labelledby="contact-channels-heading">
  <Container>
    <h2 id="contact-channels-heading" class={showHeading ? 'section-title text-3xl font-bold text-navy-900 sm:text-4xl' : 'sr-only'}>Canales de contacto</h2>

    <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="reveal reveal-delay-1">
      <div class="industrial-card p-6">
        <dt class="technical-label flex items-center gap-2 text-steel-600">
          <svg class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Teléfono
        </dt>
        <dd class="mt-3 space-y-1">
          <a href={telUrl(siteConfig.phone)} aria-label={`Llamar al ${siteConfig.phone}`} class="block text-gray-700 underline hover:text-steel-500">
            {siteConfig.phone}
          </a>
          <a href={telUrl(siteConfig.phoneSecondary)} aria-label={`Llamar al ${siteConfig.phoneSecondary}`} class="block text-gray-500 underline hover:text-steel-500">
            {siteConfig.phoneSecondary}
          </a>
        </dd>
      </div>
      </div>

      <div class="reveal reveal-delay-2">
      <div class="industrial-card p-6">
        <dt class="technical-label flex items-center gap-2 text-steel-600">
          <svg class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Correo
        </dt>
        <dd class="mt-3">
          <a href={`mailto:${siteConfig.email}`} aria-label={`Enviar correo a ${siteConfig.email}`} class="break-all text-gray-700 underline decoration-steel-400 underline-offset-4 hover:text-steel-600">
            {siteConfig.email}
          </a>
        </dd>
      </div>
      </div>

      <div class="reveal reveal-delay-3">
      <div class="industrial-card p-6">
        <dt class="technical-label flex items-center gap-2 text-steel-600">
          <svg class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          WhatsApp
        </dt>
        <dd class="mt-3">
          <a href={`https://wa.me/${siteConfig.whatsapp}`} aria-label="Abrir WhatsApp de EAD Oleohidráulica" class="text-gray-700 underline hover:text-steel-500" target="_blank" rel="noopener noreferrer">
            Abrir chat
          </a>
        </dd>
      </div>
      </div>

      <div class="reveal reveal-delay-4 lg:col-span-2">
      <div class="industrial-card p-6">
        <dt class="technical-label flex items-center gap-2 text-steel-600">
          <svg class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Dirección
        </dt>
        <dd class="mt-3 space-y-1">
          <p class="text-gray-700">{siteConfig.address}, {siteConfig.locality}</p>
          <p class="text-sm text-gray-500">{siteConfig.hours}</p>
          {siteConfig.mapUrl !== 'PENDING_CONFIRMATION' ? (
            <a href={siteConfig.mapUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex text-sm font-semibold text-navy-800 underline hover:text-steel-500">
              Abrir ubicación
            </a>
          ) : (
            <p class="mt-2 text-xs text-amber-700">Enlace de ubicación pendiente de confirmación.</p>
          )}
        </dd>
      </div>
      </div>

      <div class="reveal reveal-delay-5">
      <div class="industrial-card p-6">
        <dt class="technical-label text-steel-600">Instagram</dt>
        <dd class="mt-3">
          <a href={siteConfig.instagram} aria-label="Abrir Instagram de EAD Oleohidráulica" target="_blank" rel="noopener noreferrer" class="text-gray-700 underline hover:text-steel-500">
            @oleohidraulica_ead
          </a>
        </dd>
      </div>
      </div>
    </dl>
  </Container>
</section>
