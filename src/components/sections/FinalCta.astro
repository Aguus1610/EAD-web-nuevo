---
import Container from '../ui/Container.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import { siteConfig } from '../../data/site'
import { telUrl } from '../../lib/contact'
import { withBase } from '../../lib/url'

interface Props {
  heading: string
  text: string
  cta: { label: string; href: string }
  secondaryCta?: { label: string; href: string }
  class?: string
}

const { heading, text, cta, secondaryCta, class: className } = Astro.props
---

<section class={`dark-technical-grid industrial-grain relative overflow-hidden border-t border-steel-500/30 py-section-sm sm:py-section ${className ?? ''}`}>
  <div class="section-pressure-gauge" aria-hidden="true"></div>
  <span class="fluid-particle" aria-hidden="true"></span>
  <span class="fluid-particle" aria-hidden="true"></span>
  <span class="fluid-particle" aria-hidden="true"></span>
  <div class="sticky-content-wrapper relative">
  <div
    class="brand-watermark animate-pressure bg-center bg-no-repeat opacity-[0.08]"
    style={`background-image: url('${withBase('/assets/brand/ead-logo-on-dark.png')}'); background-size: 36rem auto;`}
    aria-hidden="true"
  ></div>
  <Container>
    <div class="reveal relative grid items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16">
      <div>
        <p class="technical-label text-gold-300">Próximo paso</p>
        <h2 class="text-balance mt-3 text-4xl font-bold leading-tight text-white sm:text-5xl">{heading}</h2>
        <p class="mt-4 max-w-2xl text-lg text-gray-200">{text}</p>
      </div>
      <div class="flex flex-wrap gap-4 lg:max-w-sm lg:justify-end">
      <ButtonLink href={cta.href} variant="primary" class="shimmer-gold">
        {cta.label}
      </ButtonLink>
      {secondaryCta && (
        <ButtonLink href={secondaryCta.href} variant="secondary" class="border-white text-white hover:bg-white hover:text-navy-900">
          {secondaryCta.label}
        </ButtonLink>
      )}
      {siteConfig.phone && (
        <a
          href={telUrl(siteConfig.phone)}
          class="cut-corner inline-flex items-center justify-center gap-2 border-2 border-steel-300 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-white hover:bg-white hover:text-navy-900"
        >
          Llamar ahora
        </a>
      )}
      </div>
    </div>
  </Container>
  </div>
</section>
