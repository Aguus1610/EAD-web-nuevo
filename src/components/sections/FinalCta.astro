---
import Container from '../ui/Container.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import { primaryContact } from '../../data/site'
import { telUrl } from '../../lib/contact'

interface Props {
  heading: string
  text: string
  cta: { label: string; href: string }
  secondaryCta?: { label: string; href: string }
  class?: string
}

const { heading, text, cta, secondaryCta, class: className } = Astro.props
---

<section class={`dark-technical-grid relative overflow-hidden border-t border-navy-700 py-section-sm sm:py-section ${className ?? ''}`}>
  <div class="brand-diagonal" aria-hidden="true"></div>
  <Container>
    <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16" data-reveal>
      <div>
        <p class="technical-label">Próximo paso</p>
        <h2 class="text-balance mt-5 text-3xl font-bold uppercase leading-tight text-white sm:text-4xl lg:text-5xl">{heading}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-200">{text}</p>
      </div>
      <div class="flex flex-wrap gap-4 lg:max-w-sm lg:justify-end">
        <ButtonLink href={cta.href} variant="primary">
          {cta.label}
        </ButtonLink>
        {secondaryCta && (
          <ButtonLink href={secondaryCta.href} variant="inverse">
            {secondaryCta.label}
          </ButtonLink>
        )}
        {primaryContact.phone && (
          <a
            href={telUrl(primaryContact.phone)}
            aria-label={`Llamar a ${primaryContact.name} al ${primaryContact.phone}`}
            class="inline-flex items-center justify-center gap-2 border-2 border-white/40 px-6 py-3 text-xs font-bold uppercase tracking-[0.12em] text-white transition-colors hover:border-white hover:bg-white hover:text-navy-950"
            data-magnetic="true"
          >
            Llamar a {primaryContact.name}
          </a>
        )}
      </div>
    </div>
  </Container>
</section>
