---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import { siteConfig } from '../../data/site'
import { telUrl, whatsappUrl } from '../../lib/contact'

interface Props {
  heading: string
  text: string
  class?: string
}

const { heading, text, class: className } = Astro.props

const mapEmbedUrl = `https://www.google.com/maps?q=${siteConfig.latitude},${siteConfig.longitude}&z=15&output=embed`
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${siteConfig.latitude},${siteConfig.longitude}`
---

<section class={`border-t border-gray-200 bg-white py-section-sm sm:py-section ${className ?? ''}`}>
  <Container>
    <div class="location-layout">
      <div class="location-map" data-reveal>
        <iframe
          title="Ubicación de EAD Oleohidráulica en Colonia Barón, La Pampa"
          src={mapEmbedUrl}
          width="600"
          height="450"
          class="block h-full min-h-80 w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
        <div class="location-map__label pointer-events-none absolute left-5 top-5 z-10 border-l-2 border-gold-400 pl-3 text-white" aria-hidden="true">
          <p class="text-[0.625rem] font-bold uppercase tracking-[0.14em]">Base operativa</p>
          <p class="mt-1 text-xs">{siteConfig.locality} · {siteConfig.province}</p>
        </div>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-4 left-4 right-4 z-10 flex items-center justify-center gap-2 border-2 border-gold-400 bg-gold-400 px-4 py-2.5 text-xs font-bold uppercase tracking-[0.1em] text-navy-950 transition-colors hover:border-navy-950 hover:bg-navy-950 hover:text-white"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 12h12m-3-3l3 3-3 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Cómo llegar
        </a>
      </div>

      <div class="location-copy" data-reveal>
        <p class="technical-label">Base operativa</p>
        <SectionHeading index="05" class="mt-4">{heading}</SectionHeading>

        <address class="mt-7 not-italic space-y-3">
          <p class="text-xl font-bold text-navy-950">{siteConfig.name}</p>

          <p class="flex items-start gap-3 text-gray-600">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-steel-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" />
            </svg>
            <span>
              {siteConfig.address}<br />
              {siteConfig.locality}, {siteConfig.province}<br />
              {siteConfig.country}
            </span>
          </p>

          {siteConfig.contacts.map((contact) => (
            <div class="flex items-start gap-3">
              <svg class="h-5 w-5 shrink-0 text-steel-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <p class="font-semibold text-navy-950">{contact.name}</p>
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                  <a
                    href={telUrl(contact.phone)}
                    aria-label={`Llamar a ${contact.name} al ${contact.phone}`}
                    class="text-gray-600 transition-colors hover:text-navy-950"
                  >
                    {contact.phone}
                  </a>
                  <a
                    href={whatsappUrl('Hola, vi la web de EAD Oleohidráulica y quería hacer una consulta.', contact.whatsapp)}
                    aria-label={`Abrir WhatsApp de ${contact.name} al ${contact.phone}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-steel-600 underline decoration-steel-400 underline-offset-4 hover:text-navy-950"
                  >
                    WhatsApp
                  </a>
                </div>
              </div>
            </div>
          ))}

          {siteConfig.hours && (
            <p class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-steel-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="text-gray-600">{siteConfig.hours}</span>
            </p>
          )}
        </address>

        <p class="mt-5 max-w-xl leading-relaxed text-gray-600">{text}</p>

        <div class="mt-6">
          <ButtonLink href="/contacto" variant="primary">
            Contactarnos
          </ButtonLink>
        </div>
      </div>
    </div>
  </Container>
</section>
