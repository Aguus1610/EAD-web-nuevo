---
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import { siteConfig } from '../../data/site'
import { telUrl, whatsappUrl } from '../../lib/contact'

interface Props {
  heading: string
  text: string
}

const { heading, text } = Astro.props

const mapEmbedUrl = `https://www.google.com/maps?q=${siteConfig.latitude},${siteConfig.longitude}&z=15&output=embed`
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${siteConfig.latitude},${siteConfig.longitude}`
---

<section class="border-t border-steel-500/20 py-section-sm sm:py-section bg-white">
  <Container>
    <div class="grid items-stretch gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div class="group relative overflow-hidden rounded-xl border border-steel-500/20 bg-navy-950 shadow-lg shadow-navy-900/10">
        <iframe
          title="Ubicación de EAD Oleohidráulica en Colonia Barón, La Pampa"
          src={mapEmbedUrl}
          width="600"
          height="450"
          class="block h-full min-h-80 w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-4 left-4 right-4 flex items-center justify-center gap-2 rounded-lg bg-gold-300 px-4 py-2.5 text-sm font-bold text-navy-950 shadow-lg transition-colors hover:bg-gold-400"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 12h12m-3-3l3 3-3 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Cómo llegar
        </a>
      </div>

      <div class="flex flex-col justify-center">
        <SectionHeading>{heading}</SectionHeading>

        <address class="mt-6 not-italic space-y-3">
          <p class="text-xl font-bold text-navy-900">{siteConfig.name}</p>

          <p class="flex items-start gap-3 text-gray-600">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" />
            </svg>
            <span>
              {siteConfig.address}<br />
              {siteConfig.locality}, {siteConfig.province}<br />
              {siteConfig.country}
            </span>
          </p>

          {siteConfig.phone && (
            <p class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <a href={telUrl(siteConfig.phone)} class="text-gray-600 hover:text-navy-900 transition-colors">
                {siteConfig.phone}
              </a>
            </p>
          )}

          <p class="flex items-center gap-3">
            <svg class="h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            <a
              href={whatsappUrl('Hola, vi la web de EAD Oleohidráulica y quería hacer una consulta.')}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-navy-900 transition-colors"
            >
              {siteConfig.phone}
            </a>
          </p>

          {siteConfig.hours && (
            <p class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="text-gray-600">{siteConfig.hours}</span>
            </p>
          )}
        </address>

        <p class="mt-5 max-w-xl leading-relaxed text-gray-600">{text}</p>

        <div class="mt-6">
          <ButtonLink href="/contacto" variant="primary">
            Contactarnos
          </ButtonLink>
        </div>
      </div>
    </div>
  </Container>
</section>
