---
import type { ProductIconVariant } from '../../data/productCategories'

interface Props {
  variant: ProductIconVariant
  class?: string
}

const { variant, class: className } = Astro.props
---

<svg class={className} data-product-icon={variant} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="62" height="62" rx="12" class="icon-panel" />
  {variant === 'hidro-grubert' && (
    <>
      <circle cx="26" cy="32" r="12" class="icon-main" />
      <circle cx="26" cy="32" r="4" class="icon-accent" />
      <path d="M26 15V20M26 44V49M9 32H14M38 32H43M14 20L18 24M34 40L38 44M38 20L34 24M18 40L14 44" class="icon-main" />
      <path d="M43 24H52V40H43M43 28H38M43 36H38" class="icon-accent" />
    </>
  )}
  {variant === 'palfinger' && (
    <>
      <path d="M14 18H43M20 18V27M37 18V28" class="icon-main" />
      <circle cx="37" cy="31" r="4" class="icon-main" />
      <path d="M37 35V40C37 47 45 49 49 43C51 40 50 36 47 34C48 39 44 42 41 40" class="icon-accent" />
      <path d="M12 27H27L31 36H17L12 27Z" class="icon-main" />
    </>
  )}
  {variant === 'components' && (
    <>
      <path d="M10 25H20L25 29V35L20 39H10V25ZM54 25H44L39 29V35L44 39H54V25Z" class="icon-main" />
      <path d="M25 29H31V35H25M39 29H33V35H39M31 27V37M33 27V37" class="icon-accent" />
      <path d="M14 21V43M50 21V43" class="icon-main" />
    </>
  )}
  {variant === 'implements' && (
    <>
      <path d="M15 17H42V25H15V17ZM20 25V38M37 25V38" class="icon-main" />
      <path d="M12 38H45L51 48H18L12 38Z" class="icon-main" />
      <path d="M25 38L34 27M34 27H45V33" class="icon-accent" />
      <circle cx="34" cy="27" r="2.5" class="icon-accent-fill" />
    </>
  )}
</svg>

<style>
  .icon-panel {
    fill: #0f1f3a;
    stroke: rgba(139, 199, 223, 0.45);
  }

  .icon-main,
  .icon-accent {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .icon-main {
    stroke: #8bc7df;
  }

  .icon-accent {
    stroke: #f0c54a;
  }

  .icon-accent-fill {
    fill: #f0c54a;
  }
</style>
