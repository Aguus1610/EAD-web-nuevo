---
type VisualVariant = 'home' | 'company' | 'services' | 'products' | 'work' | 'contact' | 'error'

interface Props {
  variant?: VisualVariant
  class?: string
}

const { variant = 'home', class: className } = Astro.props

const labels: Record<VisualVariant, { top: string; code: string; bottom: string }> = {
  home: { top: 'Circuito oleohidráulico', code: 'P / A / B / T', bottom: 'Presión · caudal · control' },
  company: { top: 'Taller especializado', code: 'EAD / LP', bottom: 'Diagnóstico · ejecución' },
  services: { top: 'Áreas de trabajo', code: 'SRV / 04', bottom: 'Reparación · instalación' },
  products: { top: 'Componentes', code: 'REP / CMP', bottom: 'Compatibilidad bajo consulta' },
  work: { top: 'Registro técnico', code: 'DOC / EAD', bottom: 'Revisión previa' },
  contact: { top: 'Canal de consulta', code: 'EAD / CT', bottom: 'Colonia Barón · La Pampa' },
  error: { top: 'Ruta interrumpida', code: 'ERR / 404', bottom: 'Retorno al circuito principal' },
}

const label = labels[variant]
---

<div class={`technical-visual ${className ?? ''}`} data-visual={variant} aria-hidden="true">
  <svg viewBox="0 0 620 430" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs>
      <pattern id={`visual-grid-${variant}`} width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" class="grid-line" />
      </pattern>
      <linearGradient id={`visual-glow-${variant}`} x1="80" y1="360" x2="540" y2="72" gradientUnits="userSpaceOnUse">
        <stop stop-color="#327FA6" />
        <stop offset="1" stop-color="#F0C54A" />
      </linearGradient>
    </defs>

    <rect x="1" y="1" width="618" height="428" rx="20" class="panel" />
    <rect x="1" y="1" width="618" height="428" rx="20" fill={`url(#visual-grid-${variant})`} />
    <path d="M25 58H595" class="rule" />
    <text x="28" y="37" class="svg-label">{label.top}</text>
    <text x="592" y="37" text-anchor="end" class="svg-code">{label.code}</text>

    <g class="circuit">
      <path d="M88 334H133M191 334H252V272H285" class="pipe muted" />
      <path d="M385 272H432V145H458" class="pipe muted" />
      <path d="M533 145H558V366H88" class="pipe muted" />

      <path d="M88 334H133M191 334H252V272H285" class="pipe flow" />
      <path d="M385 272H432V145H458" class="pipe flow delay" />

      <path d="M53 316H112V379H53Z" class="component" />
      <path d="M59 341C73 333 86 349 106 339" class="fluid" />
      <text x="82" y="401" text-anchor="middle" class="part-label">TANQUE</text>

      <circle cx="162" cy="334" r="29" class="component" />
      <path d="M151 349L178 334L151 319Z" class="accent-fill" />
      <text x="162" y="384" text-anchor="middle" class="part-label">BOMBA</text>

      <rect x="285" y="222" width="100" height="100" rx="4" class="component solid" />
      <path d="M335 222V322M285 272H385M303 248L320 265M320 248L303 265M351 289L369 306M369 289L351 306" class="symbol" />
      <circle cx="303" cy="304" r="5" class="port" />
      <circle cx="368" cy="240" r="5" class="port" />
      <text x="335" y="344" text-anchor="middle" class="part-label">CONTROL</text>

      <rect x="458" y="112" width="75" height="66" rx="4" class="component solid" />
      <path d="M496 112V178M496 145H558" class="symbol" />
      <rect x="533" y="137" width="27" height="16" rx="2" class="component solid" />
      <text x="496" y="200" text-anchor="middle" class="part-label">ACTUADOR</text>

      <path d="M252 272V146H317" class="pipe thin" />
      <circle cx="344" cy="146" r="27" class="component solid" />
      <path d="M344 146L358 132M344 146L331 134" class="symbol" />
      <circle cx="344" cy="146" r="4" class="accent-fill" />
      <text x="344" y="193" text-anchor="middle" class="part-label">PRESIÓN</text>

      <circle cx="252" cy="272" r="6" class="node" />
      <circle cx="432" cy="145" r="6" class="node" />
      <circle cx="558" cy="366" r="6" class="node" />
    </g>

    <path d="M28 405H592" class="rule" />
    <text x="28" y="394" class="svg-footer">{label.bottom}</text>
    <path d="M478 394H592" stroke={`url(#visual-glow-${variant})`} stroke-width="4" />
  </svg>
</div>

<style>
  .technical-visual {
    width: 100%;
    color: #8bc7df;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgba(0, 0, 0, 0.22));
  }

  .panel {
    fill: rgba(6, 16, 31, 0.78);
    stroke: rgba(139, 199, 223, 0.38);
    stroke-width: 2;
  }

  .grid-line {
    stroke: rgba(139, 199, 223, 0.11);
    stroke-width: 1;
  }

  .rule {
    stroke: rgba(139, 199, 223, 0.3);
  }

  .svg-label,
  .svg-code,
  .svg-footer,
  .part-label {
    font-family: Consolas, monospace;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .svg-label,
  .svg-code {
    fill: #dcedf4;
    font-size: 12px;
  }

  .svg-code,
  .svg-footer {
    fill: #f0c54a;
  }

  .svg-footer {
    font-size: 10px;
  }

  .part-label {
    fill: #8bc7df;
    font-size: 9px;
  }

  .component {
    fill: rgba(15, 31, 58, 0.88);
    stroke: #8bc7df;
    stroke-width: 2.5;
  }

  .component.solid {
    fill: #0f1f3a;
  }

  .pipe {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .pipe.muted {
    stroke: rgba(139, 199, 223, 0.3);
  }

  .pipe.flow {
    stroke: #f0c54a;
    stroke-dasharray: 12 18;
    animation: hydraulic-flow 5s linear infinite;
  }

  .pipe.flow.delay {
    animation-delay: -2s;
  }

  .pipe.thin {
    stroke: #55a1c5;
    stroke-width: 3;
  }

  .symbol {
    fill: none;
    stroke: #dcedf4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .fluid {
    fill: none;
    stroke: #327fa6;
    stroke-width: 3;
  }

  .accent-fill,
  .node,
  .port {
    fill: #f0c54a;
  }

  .node {
    stroke: #0a1628;
    stroke-width: 3;
  }

  [data-visual='products'] .component,
  [data-visual='products'] .pipe.thin {
    stroke: #f0c54a;
  }

  [data-visual='contact'] .flow {
    stroke: #8bc7df;
  }

  [data-visual='error'] .flow {
    stroke: #f0c54a;
    stroke-dasharray: 4 18;
  }

  @keyframes hydraulic-flow {
    to {
      stroke-dashoffset: -60;
    }
  }
</style>
