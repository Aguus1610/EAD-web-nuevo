---
import type { MediaImage } from '../../data/media'
import { withBase } from '../../lib/url'

interface Props {
  image: MediaImage
}

const { image } = Astro.props
---

<div class="hero-backdrop pointer-events-none absolute inset-y-0 right-0 w-full overflow-hidden lg:w-[55%]" aria-hidden="true">
  <img
    src={withBase(image.src)}
    alt=""
    width={image.width}
    height={image.height}
    loading="eager"
    decoding="sync"
    fetchpriority="high"
    style={`object-position: ${image.position ?? '50% 50%'};`}
    class="hero-backdrop-image h-full w-full object-cover"
    data-hero-image
  />
  <div class="hero-backdrop-shade absolute inset-0"></div>
  <div class="hero-backdrop-fade absolute inset-0"></div>
  <div class="hero-backdrop-bottom absolute inset-x-0 bottom-0 h-1/4"></div>
</div>
