---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class={`crane-visual ${className ?? ''}`} aria-hidden="true">
  <svg viewBox="0 0 620 430" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs>
      <pattern id="crane-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" class="grid-line" />
      </pattern>
      <linearGradient id="crane-glow" x1="80" y1="360" x2="520" y2="100" gradientUnits="userSpaceOnUse">
        <stop stop-color="#327FA6" />
        <stop offset="1" stop-color="#F0C54A" />
      </linearGradient>
      <linearGradient id="boom-grad" x1="420" y1="300" x2="100" y2="80" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#1A2E4A" />
        <stop offset="1" stop-color="#246585" />
      </linearGradient>
    </defs>

    <rect x="1" y="1" width="618" height="428" rx="20" class="panel" />
    <rect x="1" y="1" width="618" height="428" rx="20" fill="url(#crane-grid)" />

    <path d="M25 58H595" class="rule" />
    <text x="28" y="37" class="svg-label">Equipos de elevación</text>
    <text x="592" y="37" text-anchor="end" class="svg-code">GRÚA / PALT</text>

    <!-- Ground -->
    <path d="M0 370H620" class="ground" />
    <path d="M0 372H620" class="ground-sub" />

    <!-- === CRANE (right side) === -->

    <!-- Crane carrier / truck body -->
    <rect x="380" y="310" width="180" height="48" rx="4" class="crane-body" />

    <!-- Lifting stabilizer / outrigger -->
    <rect x="340" y="338" width="40" height="14" rx="2" class="outrigger" />
    <rect x="335" y="344" width="50" height="8" rx="1" class="outrigger-pad" />
    <rect x="540" y="338" width="40" height="14" rx="2" class="outrigger" />
    <rect x="535" y="344" width="50" height="8" rx="1" class="outrigger-pad" />

    <!-- Turntable -->
    <ellipse cx="420" cy="310" rx="30" ry="14" class="turntable" />
    <circle cx="420" cy="310" r="10" class="turntable-pin" />

    <!-- Counterweight -->
    <path d="M555 310L580 295V320L555 320Z" class="counterweight" />

    <!-- Cab -->
    <rect x="385" y="285" width="40" height="30" rx="3" class="cab" />
    <rect x="390" y="288" width="14" height="12" rx="1" class="cab-window" />

    <!-- Boom mount / base -->
    <path d="M400 310L410 295L440 295L440 310Z" class="boom-mount" />

    <!-- Main boom section -->
    <path d="M412 295L85 85L78 95L408 305Z" class="boom-main" />

    <!-- Telescopic section 1 -->
    <path d="M310 215L75 85L70 93L300 225Z" class="boom-tele-1" />

    <!-- Telescopic section 2 -->
    <path d="M200 151L65 94L62 100L190 160Z" class="boom-tele-2" />

    <!-- Boom tip / head -->
    <polygon points="72,92 62,98 50,90 56,82 68,85" class="boom-tip" />

    <!-- Hydraulic cylinder (barrel) -->
    <rect x="408" y="320" width="100" height="11" rx="3" class="cylinder-barrel" transform="rotate(-35 408 325)" />
    <!-- Cylinder rod -->
    <line x1="490" y1="265" x2="360" y2="175" class="cylinder-rod" stroke-width="5" />
    <!-- Cylinder pivot pin -->
    <circle cx="410" cy="328" r="4" class="pivot-pin" />
    <!-- Rod connection to boom -->
    <circle cx="360" cy="175" r="3" class="pivot-pin" />

    <!-- Cable / hoist line -->
    <line x1="62" y1="95" x2="62" y2="270" class="cable" />

    <!-- Hook block -->
    <path d="M56 260H68V270H56Z" rx="1" class="hook-block" />
    <path d="M62 270V282Q62 290 56 290H55M62 282Q62 290 68 290H69" class="hook" />

    <!-- Suspended load -->
    <rect x="36" y="294" width="52" height="36" rx="2" class="load" />
    <line x1="44" y1="302" x2="80" y2="302" class="load-detail" />
    <line x1="44" y1="312" x2="80" y2="312" class="load-detail" />
    <line x1="44" y1="322" x2="72" y2="322" class="load-detail" />

    <!-- Load label -->
    <text x="62" y="348" text-anchor="middle" class="part-label">CARGA</text>

    <!-- === ELEVATED PLATFORM (left side) === -->

    <!-- Scissor lift base -->
    <rect x="190" y="324" width="60" height="12" rx="2" class="platform-base" />

    <!-- Scissor arms (X pattern) -->
    <line x1="200" y1="324" x2="230" y2="260" class="scissor-arm" />
    <line x1="240" y1="324" x2="210" y2="260" class="scissor-arm" />
    <line x1="210" y1="272" x2="235" y2="230" class="scissor-arm" />
    <line x1="230" y1="272" x2="205" y2="230" class="scissor-arm" />

    <!-- Hydraulic cylinder on scissor -->
    <rect x="215" y="300" width="8" height="20" rx="2" class="scissor-cylinder" transform="rotate(-30 219 310)" />

    <!-- Platform -->
    <rect x="190" y="218" width="50" height="10" rx="2" class="platform-deck" />
    <rect x="188" y="216" width="54" height="4" rx="1" class="platform-rail" />

    <!-- Person silhouette -->
    <circle cx="215" cy="202" r="7" class="person" />
    <path d="M209 218Q215 212 221 218L219 232H211Z" class="person" />

    <!-- Platform label -->
    <text x="215" y="256" text-anchor="middle" class="part-label">PLAT. ELEVADORA</text>

    <!-- Crane label -->
    <text x="420" y="384" text-anchor="middle" class="part-label">GRÚA TELESCÓPICA</text>

    <!-- === Ambient / technical details === -->

    <!-- Height indicator marks on boom area -->
    <line x1="135" y1="130" x2="160" y2="112" class="measure-line" />
    <line x1="125" y1="140" x2="152" y2="120" class="measure-line" />
    <text x="162" y="108" class="measure-text">ALCANCE</text>

    <!-- Load weight indicator -->
    <text x="92" y="280" text-anchor="end" class="measure-text">PESO</text>

    <!-- Golden accent: hydraulic fluid glow along cylinder -->
    <circle cx="410" cy="340" r="2" class="accent-dot" />
    <circle cx="360" cy="175" r="2" class="accent-dot" />

    <!-- Bottom rule and footer -->
    <path d="M28 405H592" class="rule" />
    <text x="28" y="394" class="svg-footer">Carga · elevación · seguridad</text>
    <path d="M450 394H592" stroke="url(#crane-glow)" stroke-width="4" />
  </svg>
</div>

<style>
  .crane-visual {
    width: 100%;
    color: #8bc7df;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgba(0, 0, 0, 0.22));
  }

  .panel {
    fill: rgba(6, 16, 31, 0.78);
    stroke: rgba(139, 199, 223, 0.38);
    stroke-width: 2;
  }

  .grid-line {
    stroke: rgba(139, 199, 223, 0.11);
    stroke-width: 1;
  }

  .rule {
    stroke: rgba(139, 199, 223, 0.3);
  }

  .svg-label,
  .svg-code,
  .svg-footer,
  .part-label {
    font-family: Consolas, monospace;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .svg-label,
  .svg-code {
    fill: #dcedf4;
    font-size: 12px;
  }

  .svg-code,
  .svg-footer {
    fill: #f0c54a;
  }

  .svg-footer {
    font-size: 10px;
  }

  .part-label {
    fill: #8bc7df;
    font-size: 9px;
  }

  .measure-text {
    fill: rgba(139, 199, 223, 0.45);
    font-family: Consolas, monospace;
    font-size: 7px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .measure-line {
    stroke: rgba(139, 199, 223, 0.2);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .ground {
    stroke: rgba(139, 199, 223, 0.25);
    stroke-width: 1;
  }

  .ground-sub {
    stroke: rgba(139, 199, 223, 0.12);
    stroke-width: 1;
  }

  /* Crane body */
  .crane-body {
    fill: rgba(10, 22, 40, 0.9);
    stroke: #8bc7df;
    stroke-width: 2;
  }

  .outrigger {
    fill: rgba(15, 31, 58, 0.88);
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .outrigger-pad {
    fill: rgba(139, 199, 223, 0.15);
    stroke: rgba(139, 199, 223, 0.3);
    stroke-width: 1;
  }

  .turntable {
    fill: #0f1f3a;
    stroke: #55a1c5;
    stroke-width: 2;
  }

  .turntable-pin {
    fill: #327fa6;
    stroke: #8bc7df;
    stroke-width: 1;
  }

  .counterweight {
    fill: rgba(10, 22, 40, 0.95);
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .cab {
    fill: rgba(10, 22, 40, 0.9);
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .cab-window {
    fill: rgba(139, 199, 223, 0.25);
    stroke: #55a1c5;
    stroke-width: 1;
  }

  .boom-mount {
    fill: #0f1f3a;
    stroke: #55a1c5;
    stroke-width: 1.5;
  }

  /* Boom sections */
  .boom-main {
    fill: url(#boom-grad);
    stroke: #55a1c5;
    stroke-width: 1.5;
  }

  .boom-tele-1 {
    fill: #184060;
    stroke: #55a1c5;
    stroke-width: 1;
  }

  .boom-tele-2 {
    fill: #1c4d72;
    stroke: #55a1c5;
    stroke-width: 1;
  }

  .boom-tip {
    fill: #0f1f3a;
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  /* Hydraulic cylinder */
  .cylinder-barrel {
    fill: #0f1f3a;
    stroke: #f0c54a;
    stroke-width: 2;
  }

  .cylinder-rod {
    stroke: #f0c54a;
    stroke-linecap: round;
  }

  .pivot-pin {
    fill: #f0c54a;
  }

  /* Cable and hook */
  .cable {
    stroke: rgba(139, 199, 223, 0.5);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .hook-block {
    fill: #0f1f3a;
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .hook {
    fill: none;
    stroke: #f0c54a;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .load {
    fill: rgba(15, 31, 58, 0.88);
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .load-detail {
    stroke: rgba(139, 199, 223, 0.3);
    stroke-width: 1;
  }

  /* Platform */
  .platform-base {
    fill: rgba(10, 22, 40, 0.9);
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .scissor-arm {
    stroke: #327fa6;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .scissor-cylinder {
    fill: rgba(15, 31, 58, 0.88);
    stroke: #f0c54a;
    stroke-width: 1.5;
  }

  .platform-deck {
    fill: #0f1f3a;
    stroke: #8bc7df;
    stroke-width: 1.5;
  }

  .platform-rail {
    fill: rgba(139, 199, 223, 0.2);
    stroke: #55a1c5;
    stroke-width: 1;
  }

  .person {
    fill: #dcedf4;
    stroke: #8bc7df;
    stroke-width: 1;
  }

  .accent-dot {
    fill: #f0c54a;
    opacity: 0.8;
    animation: dot-pulse 2s ease-in-out infinite;
  }

  .accent-dot:nth-child(2) {
    animation-delay: -1s;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 0.5; r: 2; }
    50% { opacity: 1; r: 3; }
  }

  .load {
    fill: rgba(15, 31, 58, 0.88);
    stroke: #8bc7df;
    stroke-width: 1.5;
    animation: load-sway 4s ease-in-out infinite;
    transform-origin: 62px 290px;
  }

  @keyframes load-sway {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-1.5deg); }
    75% { transform: rotate(1.5deg); }
  }

  .cable {
    stroke: rgba(139, 199, 223, 0.5);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
    animation: cable-drift 4s ease-in-out infinite;
  }

  @keyframes cable-drift {
    0%, 100% { stroke-dashoffset: 0; }
    50% { stroke-dashoffset: -12; }
  }
</style>
