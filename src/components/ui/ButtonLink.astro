---
import { withBase } from '../../lib/url'

interface Props {
  href: string
  variant?: 'primary' | 'secondary' | 'secondary-light' | 'ghost'
  class?: string
}

const { href, variant = 'primary', class: className } = Astro.props

const base = 'cut-corner inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-bold tracking-wide transition-colors no-underline'

const variants: Record<string, string> = {
  primary: 'border-2 border-yellow-400 bg-yellow-400 text-ink-900 hover:border-yellow-500 hover:bg-yellow-500',
  secondary: 'border-2 border-deep-900 text-deep-900 hover:bg-deep-900 hover:text-white',
  'secondary-light': 'border-2 border-white text-white hover:bg-white hover:text-deep-900',
  ghost: 'text-deep-900 underline decoration-yellow-400 decoration-2 underline-offset-4 hover:text-blue-600',
}
---

<a href={withBase(href)} class={`${base} ${variants[variant]} ${className ?? ''}`}>
  <slot />
</a>
