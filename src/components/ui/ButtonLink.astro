---
import { withBase } from '../../lib/url'

interface Props {
  href: string
  variant?: 'primary' | 'secondary' | 'inverse' | 'ghost'
  class?: string
}

const { href, variant = 'primary', class: className } = Astro.props

const base = 'inline-flex items-center justify-center gap-2 px-6 py-3 text-xs font-bold uppercase tracking-[0.12em] transition-colors no-underline'

const variants: Record<string, string> = {
  primary: 'border-2 border-gold-400 bg-gold-400 text-navy-950 hover:border-navy-950 hover:bg-navy-950 hover:text-white',
  secondary: 'border-2 border-navy-950 text-navy-950 hover:bg-navy-950 hover:text-white',
  inverse: 'border-2 border-white text-white hover:bg-white hover:text-navy-950',
  ghost: 'px-0 py-0 text-navy-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-steel-600',
}
---

<a
  href={withBase(href)}
  class={`${base} ${variants[variant]} ${className ?? ''}`}
  data-magnetic={variant === 'ghost' ? undefined : 'true'}
>
  <slot />
</a>
