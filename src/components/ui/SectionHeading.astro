---
interface Props {
  tag?: 'h1' | 'h2' | 'h3'
  id?: string
  class?: string
  light?: boolean
}

const { tag: Tag = 'h2', id, class: className, light = false } = Astro.props
---

<Tag id={id} class={`section-title text-3xl font-bold leading-tight sm:text-4xl ${light ? 'text-white' : 'text-deep-900'} ${className ?? ''}`}>
  <slot />
</Tag>
