---
interface Props {
  tag?: 'h1' | 'h2' | 'h3'
  class?: string
  light?: boolean
}

const { tag: Tag = 'h2', class: className, light = false } = Astro.props
---

<Tag class={`section-title text-3xl font-bold leading-tight sm:text-4xl ${light ? 'text-white' : 'text-navy-900'} ${className ?? ''}`}>
  <slot />
</Tag>
