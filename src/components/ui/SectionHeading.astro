---
interface Props {
  tag?: 'h1' | 'h2' | 'h3'
  id?: string
  class?: string
  light?: boolean
  index?: string
}

const { tag: Tag = 'h2', id, class: className, light = false, index } = Astro.props
---

<Tag
  id={id}
  data-index={index}
  data-reveal
  class={`section-title text-3xl font-bold leading-tight sm:text-4xl ${light ? 'text-white' : 'text-navy-900'} ${className ?? ''}`}
>
  <slot />
</Tag>
