---
import type { MediaImage } from '../../data/media'
import { withBase } from '../../lib/url'

interface Props {
  image: MediaImage
  class?: string
  imageClass?: string
  label?: string
  loading?: 'eager' | 'lazy'
  priority?: boolean
}

const {
  image,
  class: className,
  imageClass,
  loading = 'lazy',
  priority = false,
} = Astro.props
---

<div class={`photo-frame relative isolate overflow-hidden ${className ?? ''}`} data-reveal="media">
  <img
    src={withBase(image.src)}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading={priority ? 'eager' : loading}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    style={`object-position: ${image.position ?? '50% 50%'};`}
    class={`h-full w-full object-cover ${imageClass ?? ''}`}
  />
</div>
