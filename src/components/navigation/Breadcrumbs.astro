---
import { withBase } from '../../lib/url'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  crumbs: Crumb[]
}

const { crumbs } = Astro.props
---

<div class="border-b border-gray-200 bg-white">
  <nav aria-label="Migas de pan" class="mx-auto max-w-(--content-max) px-4 py-3 sm:px-6 lg:px-8">
    <ol class="flex flex-wrap items-center gap-1 text-xs font-bold uppercase tracking-[0.08em] text-gray-500">
      <li>
        <a href={withBase('/')} class="transition-colors hover:text-steel-600">Inicio</a>
      </li>
      {crumbs.map((crumb) => (
        <li class="flex items-center gap-1">
          <span class="text-gold-500" aria-hidden="true">/</span>
          {crumb.href ? (
            <a href={withBase(crumb.href)} class="transition-colors hover:text-steel-600">{crumb.label}</a>
          ) : (
            <span class="font-bold text-navy-950" aria-current="page">{crumb.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
</div>
