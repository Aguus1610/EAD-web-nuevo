---
import { mainNav } from '../../data/navigation'
import ButtonLink from '../ui/ButtonLink.astro'
import { withBase } from '../../lib/url'

interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props

function isActive(linkHref: string): boolean {
  if (linkHref === '/') return currentPath === '/'
  return currentPath.startsWith(linkHref)
}
---

<div class="md:hidden" x-data>
  <button
    id="menu-toggle"
    class="flex h-10 w-10 items-center justify-center rounded-md text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-300"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Abrir menú"
    type="button"
  >
    <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-16 z-40 hidden border-t border-steel-500/30 bg-navy-950 shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-label="Navegación"
  >
    <nav aria-label="Móvil">
      <ul class="divide-y divide-white/10 px-4 py-4">
        {mainNav.map((link) => (
          <li>
            <a
              href={withBase(link.href)}
              class={`block rounded-md px-3 py-3 text-base font-medium transition-colors
                ${isActive(link.href)
                  ? 'bg-steel-500/20 text-white font-semibold'
                  : 'text-gray-200 hover:bg-white/10 hover:text-white'
                }
              `}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="pt-4">
          <ButtonLink href="/contacto" variant="primary" class="w-full justify-center">
            Solicitar presupuesto
          </ButtonLink>
        </li>
      </ul>
    </nav>
  </div>
</div>

<script is:inline>
  (function () {
    const toggle = document.getElementById('menu-toggle')
    const menu = document.getElementById('mobile-menu')
    const iconOpen = document.getElementById('menu-icon-open')
    const iconClose = document.getElementById('menu-icon-close')
    const links = menu?.querySelectorAll('a')
    let isOpen = false

    if (!toggle || !menu) return

    function open() {
      isOpen = true
      toggle.setAttribute('aria-expanded', 'true')
      toggle.setAttribute('aria-label', 'Cerrar menú')
      menu.classList.remove('hidden')
      iconOpen?.classList.add('hidden')
      iconClose?.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
      if (links && links.length > 0) links[0].focus()
    }

    function close() {
      isOpen = false
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', 'Abrir menú')
      menu.classList.add('hidden')
      iconOpen?.classList.remove('hidden')
      iconClose?.classList.add('hidden')
      document.body.style.overflow = ''
      toggle.focus()
    }

    toggle.addEventListener('click', function () {
      isOpen ? close() : open()
    })

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) close()
    })

    links?.forEach(function (link) {
      link.addEventListener('click', close)
    })

    // Close on resize to desktop
    let mql = window.matchMedia('(min-width: 768px)')
    mql.addEventListener('change', function (e) {
      if (e.matches && isOpen) close()
    })
  })()
</script>
