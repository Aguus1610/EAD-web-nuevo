---
import { siteConfig } from '../../data/site'
import { footerGroups } from '../../data/navigation'
import BrandLogo from '../ui/BrandLogo.astro'
import ContactLinks from './ContactLinks.astro'
import SocialLinks from './SocialLinks.astro'
import { withBase } from '../../lib/url'
---

<footer class="site-footer dark-technical-grid text-white">
  <div class="brand-bar" aria-hidden="true"></div>
  <span class="footer-mark" aria-hidden="true">EAD</span>
  <div class="footer-content mx-auto max-w-(--content-max) px-4 py-12 sm:px-6 lg:px-8" data-reveal>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr_1fr_1fr]">
      <div>
        <a href={withBase('/')} aria-label="Ir al inicio" class="inline-flex">
          <BrandLogo brand="ead" variant="light" loading="lazy" class="h-20 w-auto" />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-gray-300">
          Oleohidráulica en Colonia Barón, La Pampa.
        </p>
      </div>

      {footerGroups.map((group) => (
        <nav aria-label={`Footer: ${group.label}`}>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-gold-400">{group.label}</p>
          <ul class="mt-4 space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={withBase(link.href)}
                  class="text-sm text-gray-300 transition-colors hover:text-gold-400"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-gold-400">Contacto</p>
        <div class="mt-4">
          <ContactLinks class="flex-col items-start gap-2.5" />
        </div>
        <div class="mt-4">
          <SocialLinks />
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-(--content-max) px-4 py-4 text-center text-xs leading-relaxed text-gray-400 sm:px-6 lg:px-8">
      &copy; {new Date().getFullYear()} {siteConfig.name}. {siteConfig.address}, {siteConfig.locality}, {siteConfig.province}.
    </div>
  </div>
</footer>
