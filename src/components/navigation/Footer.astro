---
import { siteConfig } from '../../data/site'
import { footerGroups } from '../../data/navigation'
import BrandLogo from '../ui/BrandLogo.astro'
import ContactLinks from './ContactLinks.astro'
import SocialLinks from './SocialLinks.astro'
import { withBase } from '../../lib/url'
---

<footer class="dark-technical-grid relative border-t border-steel-500/30 bg-navy-950">
  <div class="absolute inset-x-0 top-0 h-px bg-gold-300/60" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-(--content-max) flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href={withBase('/')} aria-label="Ir al inicio">
        <BrandLogo brand="ead" variant="light" loading="lazy" class="h-10 w-auto" />
      </a>

      <nav aria-label="Footer" class="hidden items-center gap-5 lg:flex">
        {footerGroups.flatMap((group) => group.links).map((link) => (
          <a
            href={withBase(link.href)}
            class="text-sm text-gray-400 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-400">
      <ContactLinks />
      <SocialLinks />
    </div>
  </div>

  <div class="border-t border-gray-800/40 py-2 text-center text-xs text-gray-500">
    &copy; {new Date().getFullYear()} {siteConfig.name}. {siteConfig.address}, {siteConfig.locality}, {siteConfig.province}.
  </div>
</footer>
