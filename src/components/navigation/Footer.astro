---
import { siteConfig } from '../../data/site'
import { footerGroups } from '../../data/navigation'
import BrandLogo from '../ui/BrandLogo.astro'
import ContactLinks from './ContactLinks.astro'
import SocialLinks from './SocialLinks.astro'
import { withBase } from '../../lib/url'
---

<footer class="dark-technical-grid relative overflow-hidden border-t border-steel-500/30 bg-navy-950">
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-steel-500 via-gold-300 to-steel-500" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-(--content-max) px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <BrandLogo brand="ead" variant="light" loading="lazy" class="h-20" />
        <p class="mt-3 text-sm leading-relaxed text-gray-400">
          {siteConfig.description}
        </p>
        <SocialLinks class="mt-4" />
      </div>

      {footerGroups.map((group) => (
        <div>
          <h3 class="text-sm font-semibold text-white">{group.label}</h3>
          <ul class="mt-3 space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={withBase(link.href)}
                  class="text-sm text-gray-400 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-sm font-semibold text-white">Contacto</h3>
        <div class="mt-3 space-y-2 text-sm text-gray-400">
          {siteConfig.address && (
            <p>
              {siteConfig.address}<br />
              {siteConfig.locality}, {siteConfig.province}<br />
              {siteConfig.country}
            </p>
          )}
          <ContactLinks />
          {siteConfig.hours && <p class="mt-2">{siteConfig.hours}</p>}
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-800 pt-6 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
    </div>
  </div>
</footer>
