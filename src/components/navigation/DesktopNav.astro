---
import { mainNav } from '../../data/navigation'
import { withBase } from '../../lib/url'

interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props

function isActive(linkHref: string): boolean {
  if (linkHref === '/') return currentPath === '/'
  return currentPath.startsWith(linkHref)
}
---

<nav aria-label="Principal" class="hidden md:block">
  <ul class="flex items-center gap-1">
    {mainNav.map((link) => (
      <li>
        <a
          href={withBase(link.href)}
          class={`nav-link relative px-3 py-2 text-xs font-bold uppercase tracking-[0.08em] transition-colors
            ${isActive(link.href)
              ? 'is-active text-navy-950'
              : 'text-gray-600 hover:text-steel-600'
            }
          `}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
