---
import BrandLogo from '../ui/BrandLogo.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import DesktopNav from './DesktopNav.astro'
import MobileNav from './MobileNav.astro'
import { withBase } from '../../lib/url'

interface Props {
  currentPath?: string
  logoVariant?: 'light' | 'dark'
}

const { currentPath = '/', logoVariant = 'dark' } = Astro.props
---

<header class="sticky top-0 z-30 border-b border-steel-500/35 bg-navy-950/95 shadow-lg shadow-navy-950/20 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-(--content-max) items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={withBase('/')} class="flex-shrink-0" aria-label="Ir al inicio">
      <BrandLogo brand="ead" variant={logoVariant} />
    </a>

    <DesktopNav currentPath={currentPath} />

    <div class="flex items-center gap-3">
      <ButtonLink href="/contacto" variant="primary" class="hidden py-2 sm:inline-flex">
        Presupuesto
      </ButtonLink>
      <MobileNav currentPath={currentPath} />
    </div>
  </div>
</header>
