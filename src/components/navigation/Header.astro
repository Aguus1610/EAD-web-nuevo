---
import BrandLogo from '../ui/BrandLogo.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import ThemeToggle from '../ui/ThemeToggle.astro'
import DesktopNav from './DesktopNav.astro'
import MobileNav from './MobileNav.astro'
import { withBase } from '../../lib/url'

interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props
---

<header id="site-header" class="site-header sticky top-0 z-50" data-header>
  <div class="brand-bar" aria-hidden="true"></div>
  <div class="mx-auto flex h-20 max-w-(--content-max) items-center justify-between px-4 sm:px-6 lg:h-24 lg:px-8">
    <a href={withBase('/')} class="flex-shrink-0" aria-label="Ir al inicio">
      <span class="theme-logo theme-logo--on-light">
        <BrandLogo brand="ead" variant="dark" alt="" class="h-12 lg:h-14" />
      </span>
      <span class="theme-logo theme-logo--on-dark">
        <BrandLogo brand="ead" variant="light" alt="" class="h-20 lg:h-24" />
      </span>
    </a>

    <DesktopNav currentPath={currentPath} />

    <div class="flex items-center gap-2 sm:gap-3">
      <ThemeToggle />
      <div class="hidden sm:block">
        <ButtonLink href="/contacto" variant="primary" class="py-2.5">
          Presupuesto
        </ButtonLink>
      </div>
      <MobileNav currentPath={currentPath} />
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true">
    <span class="scroll-progress__bar" data-scroll-progress></span>
  </div>
</header>
